// Pagamento
// =============================================================================

model Payment {
  id                String            @id @default(uuid())
  orderId           String            @unique
  method            PaymentMethodType
  provider          PaymentProvider?
  status            PaymentStatus     @default(PENDING)
  amount            Int // Em centavos
  paidAt            DateTime?
  confirmedBy       String? // legado: userId que confirmou
  reportedAt        DateTime?
  failedAt          DateTime?
  failureReasonCode String?           @db.VarChar(64)
  failureNote       String?           @db.VarChar(500)
  cancelledAt       DateTime?
  refundedAt        DateTime?
  refundedBy        String?
  refundReasonCode  String?           @db.VarChar(64)
  refundNote        String?           @db.VarChar(500)
  refundAmount      Int?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  statusHistory      PaymentStatusHistory[]
  mercadoPagoPayment MercadoPagoPayment?

  @@unique([id, orderId])
  @@index([status])
  @@map("payments")
}

model StorePaymentProviderConnection {
  id                     String                          @id @default(uuid())
  tenantId               String
  storeId                String
  provider               PaymentProvider
  status                 PaymentProviderConnectionStatus @default(ERROR)
  providerUserId         String                          @db.VarChar(64)
  liveMode               Boolean
  scopes                 String[]                        @default([])
  accessTokenCiphertext  String?                         @db.Text
  accessTokenIv          String?                         @db.VarChar(64)
  refreshTokenCiphertext String?                         @db.Text
  refreshTokenIv         String?                         @db.VarChar(64)
  tokenExpiresAt         DateTime?
  credentialVersion      Int                             @default(1)
  refreshLeaseId         String?                         @db.Uuid
  refreshLeaseExpiresAt  DateTime?
  connectedAt            DateTime?
  refreshedAt            DateTime?
  disconnectedAt         DateTime?
  reauthRequiredAt       DateTime?
  lastErrorCode          String?                         @db.VarChar(64)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store               Store                @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
