// =============================================================================
// PedidoLocal — Schema Prisma
// =============================================================================
// Todas as entidades do MVP.
// Usa PostgreSQL + Supabase.
// UUIDs como chave primária.
// Todas as entidades privadas possuem tenantId.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Enums
// =============================================================================

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum TenantRole {
  OWNER
  MANAGER
  ATTENDANT
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum StoreStatus {
  OPEN
  CLOSED
  PAUSED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum StoreScheduleExceptionType {
  CLOSED
  CUSTOM_HOURS
}

enum OrderModality {
  DELIVERY
  PICKUP
}

enum PaymentMethodType {
  PIX
  CASH
  CARD_ON_DELIVERY
}

enum StorePaymentMode {
  MANUAL
  ONLINE
}

enum PaymentProvider {
  MERCADO_PAGO
}

enum PaymentProviderConnectionStatus {
  ACTIVE
  REAUTH_REQUIRED
  DISCONNECTED
  REVOKED
  ERROR
}

enum MercadoPagoCreationStatus {
  PENDING
  CREATED
  RETRYABLE_ERROR
  FAILED
}

enum CouponReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum PaymentProviderAlertPriority {
  HIGH
  CRITICAL
}

enum PaymentProviderAlertStatus {
  OPEN
  RESOLVED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CUSTOMER_REPORTED_PAID
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum OrderChangeSource {
  CUSTOMER
  DASHBOARD
  SYSTEM
  WEBHOOK
  SUPPORT
  QUEUE
}

enum OrderOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum OrderOutboxEventType {
  ORDER_CREATED
  ORDER_ACCEPTED
  ORDER_PREPARING
  ORDER_READY
  ORDER_DISPATCHED
  ORDER_COMPLETED
  ORDER_CANCELLED
  ORDER_TRANSITION_UNDONE
  ORDER_INTERNAL_NOTE_ADDED
  PAYMENT_UPDATED
}

enum WebPushDispatchStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum WebPushDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  REVOKED
  SKIPPED
}

enum OrderOperationalSlaStage {
  WARNING
  CRITICAL
}

enum OrderCancellationReasonCode {
  CUSTOMER_REQUEST
  PRODUCT_UNAVAILABLE
  STORE_UNABLE_TO_FULFILL
  ADDRESS_PROBLEM
  PAYMENT_NOT_IDENTIFIED
  ONLINE_PAYMENT_CREATION_FAILED
  PIX_EXPIRED
  PROVIDER_CANCELLED
  DUPLICATE_ORDER
  FRAUD_SUSPECTED
  OTHER
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum CustomerAddressLabel {
  HOME
  WORK
  OTHER
}

enum CustomerRecognitionThrottleScope {
  IP
  PHONE
  STORE
  SESSION
}

enum CheckoutRecognitionConfirmationMode {
  SAVED_ADDRESS
  NEW_ADDRESS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  STATUS_CHANGE
  PAYMENT_CONFIRMED
  ORDER_CREATED
  ORDER_ACCEPTED
  ORDER_PREPARATION_STARTED
  ORDER_READY
  ORDER_DISPATCHED
  ORDER_COMPLETED
  ORDER_CANCELLED
  ORDER_TRANSITION_UNDONE
  PAYMENT_REPORTED
  PAYMENT_FAILED
  PAYMENT_CANCELLED
  PAYMENT_REFUNDED
  ORDER_INTERNAL_NOTE_ADDED
  TENANT_SUSPENDED
  TENANT_ACTIVATED
  CUSTOMIZATION_DRAFT_SAVED
  CUSTOMIZATION_DRAFT_DISCARDED
  CUSTOMIZATION_PUBLISHED
  CUSTOMIZATION_REVISION_RESTORED
  CUSTOMIZATION_DEFAULT_RESTORED
  ASSET_UPLOADED
  ASSET_REPLACED
  ASSET_DELETED
  BANNER_CREATED
  BANNER_UPDATED
  BANNER_DELETED
  DOMAIN_REQUESTED
  DOMAIN_STATUS_CHANGED
  ENTITLEMENT_UPDATED
  BRANDING_VISIBILITY_CHANGED
  STOREFRONT_DISPLAY_UPDATED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_ARCHIVED
  CATEGORY_RESTORED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_ARCHIVED
  PRODUCT_RESTORED
  PRODUCT_DUPLICATED
  PRODUCT_AVAILABILITY_CHANGED
  PRODUCT_PRICE_CHANGED
  PRODUCT_IMAGE_UPDATED
  OPTION_GROUP_CREATED
  OPTION_GROUP_UPDATED
  OPTION_GROUP_ARCHIVED
  OPTION_CREATED
  OPTION_UPDATED
  OPTION_ARCHIVED
  CATALOG_REORDERED
  COUPON_CREATED
  COUPON_UPDATED
  COUPON_DELETED
  PAYMENT_PROVIDER_CONNECTED
  PAYMENT_PROVIDER_DISCONNECTED
  PAYMENT_PROVIDER_REAUTH_REQUIRED
  PAYMENT_PROVIDER_STATUS_UPDATED
}

enum CustomizationRevisionAction {
  PUBLISHED
}

enum CustomizationRevisionOrigin {
  SUPER_ADMIN_UI
  RESTORE
  MIGRATION
  SYSTEM_DEFAULT
}

enum StoreAssetType {
  LOGO
  LOGO_DARK
  COVER
  FAVICON
  SOCIAL_IMAGE
  BANNER
  CATEGORY_IMAGE
  PRODUCT_IMAGE
}

enum StoreAssetStatus {
  ACTIVE
  DELETED
}

enum BannerDestinationType {
  NONE
  CATEGORY
  PRODUCT
  COUPON
  INTERNAL_PATH
}

enum StoreDomainType {
  SUBDOMAIN
  CUSTOM
}

enum StoreDomainStatus {
  PENDING
  VERIFYING
  ACTIVE
  FAILED
  DISABLED
}

// =============================================================================
// Usuário e Sessão
// =============================================================================

model User {
  id            String       @id @default(uuid())
  authUserId    String?      @unique
  email         String       @unique
  name          String
  platformRole  PlatformRole @default(USER)
  passwordHash  String?
  isActive      Boolean      @default(true)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions                  Session[]
  tenantMembers             TenantMember[]
  auditLogs                 AuditLog[]
  customizationsPublished   StoreCustomization[]          @relation("CustomizationPublishedBy")
  customizationsUpdated     StoreCustomization[]          @relation("CustomizationUpdatedBy")
  customizationRevisions    StoreCustomizationRevision[]  @relation("CustomizationRevisionActor")
  storeAssetsCreated        StoreAsset[]                  @relation("StoreAssetCreatedBy")
  scheduleExceptionsCreated StoreScheduleException[]      @relation("StoreScheduleExceptionCreatedBy")
  slugRedirectsCreated      StoreSlugRedirect[]           @relation("StoreSlugRedirectCreatedBy")
  ordersCancelled           Order[]                       @relation("OrderCancelledBy")
  orderStatusChanges        OrderStatusHistory[]          @relation("OrderStatusChangedBy")
  orderInternalNotes        OrderInternalNote[]           @relation("OrderInternalNoteAuthor")
  paymentStatusChanges      PaymentStatusHistory[]        @relation("PaymentStatusChangedBy")
  paymentOAuthAttempts      PaymentProviderOAuthAttempt[] @relation("PaymentProviderOAuthAttemptInitiatedBy")

  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// =============================================================================
// Tenant (Estabelecimento)
// =============================================================================

model Tenant {
  id        String       @id @default(uuid())
  name      String
  document  String? // CNPJ/CPF
  status    TenantStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  members                       TenantMember[]
  stores                        Store[]
  categories                    Category[]
  products                      Product[]
  deliveryZones                 DeliveryZone[]
  deliveryPostalRanges          DeliveryZonePostalRange[]
  customers                     Customer[]
  deviceRecognitions            CustomerDeviceRecognition[]
  recognitionThrottles          CustomerRecognitionThrottle[]
  orders                        Order[]
  coupons                       Coupon[]
  auditLogs                     AuditLog[]
  orderOutboxEvents             OrderOutboxEvent[]
  paymentStatusHistory          PaymentStatusHistory[]
  slugRedirects                 StoreSlugRedirect[]
  scheduleExceptions            StoreScheduleException[]
  orderPushSubscriptions        OrderPushSubscription[]
  webPushDispatches             WebPushDispatch[]
  webPushDeliveries             WebPushDelivery[]
  storeStaffPushSubscriptions   StoreStaffPushSubscription[]
  storeWebPushDispatches        StoreWebPushDispatch[]
  storeWebPushDeliveries        StoreWebPushDelivery[]
  orderOperationalSlaAlerts     OrderOperationalSlaAlert[]
  orderOperationalSlaDeliveries OrderOperationalSlaDelivery[]
  paymentProviderConnections    StorePaymentProviderConnection[]
  paymentOAuthAttempts          PaymentProviderOAuthAttempt[]
  mercadoPagoPayments           MercadoPagoPayment[]

  @@map("tenants")
}

model TenantMember {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  role      TenantRole
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeStaffPushSubscriptions StoreStaffPushSubscription[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_members")
}

// =============================================================================
// Loja
// =============================================================================

model Store {
  id                   String      @id @default(uuid())
  tenantId             String
  slug                 String      @unique
  name                 String
  description          String?
  phone                String?
  whatsapp             String?
  logoUrl              String?
  coverUrl             String?
  status               StoreStatus @default(CLOSED)
  isActive             Boolean     @default(true)
  timeZone             String      @default("America/Fortaleza")
  configurationVersion Int         @default(0)
  catalogVersion       Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings StoreSettings?

  address                       StoreAddress?
  openingHours                  OpeningHour[]
  scheduleExceptions            StoreScheduleException[]
  categories                    Category[]
  products                      Product[]
  deliveryZones                 DeliveryZone[]
  deliveryPostalRanges          DeliveryZonePostalRange[]
  customerAddressUses           CustomerAddressStoreUse[]
  recognitionSessions           CheckoutRecognitionSession[]
  recognitionAddressReferences  CheckoutRecognitionAddressReference[]
  deviceRecognitions            CustomerDeviceRecognition[]
  recognitionThrottles          CustomerRecognitionThrottle[]
  coupons                       Coupon[]
  orders                        Order[]
  orderCounter                  StoreOrderCounter?
  customization                 StoreCustomization?
  auditLogs                     AuditLog[]
  orderOutboxEvents             OrderOutboxEvent[]
  paymentStatusHistory          PaymentStatusHistory[]
  assets                        StoreAsset[]
  banners                       StoreBanner[]
  domains                       StoreDomain[]
  entitlement                   StoreEntitlement?
  slugRedirects                 StoreSlugRedirect[]
  orderPushSubscriptions        OrderPushSubscription[]
  webPushDispatches             WebPushDispatch[]
  webPushDeliveries             WebPushDelivery[]
  storeStaffPushSubscriptions   StoreStaffPushSubscription[]
  storeWebPushDispatches        StoreWebPushDispatch[]
  storeWebPushDeliveries        StoreWebPushDelivery[]
  orderOperationalSlaAlerts     OrderOperationalSlaAlert[]
  orderOperationalSlaDeliveries OrderOperationalSlaDelivery[]
  paymentProviderConnections    StorePaymentProviderConnection[]
  paymentOAuthAttempts          PaymentProviderOAuthAttempt[]
  mercadoPagoPayments           MercadoPagoPayment[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([slug])
  @@index([status])
  @@map("stores")
}

model StoreSettings {
  id      String @id @default(uuid())
  storeId String @unique

  // Cores e aparência
  primaryColor   String @default("#f97316")
  secondaryColor String @default("#1e293b")
  fontFamily     String @default("Inter")

  // Configurações de pedido
  minOrderValue           Int     @default(0) // Em centavos
  estimatedTime           String  @default("30-50 min")
  estimatedTimeMinMinutes Int     @default(30)
  estimatedTimeMaxMinutes Int     @default(50)
  deliveryEnabled         Boolean @default(true)
  pickupEnabled           Boolean @default(true)

  // Exibição no cardápio público
  showEstimatedTimeInHero     Boolean @default(true)
  showFulfillmentInHero       Boolean @default(false)
  showMinOrderValueInHero     Boolean @default(true)
  showOpeningHoursInHero      Boolean @default(false)
  showFullAddressInStoreInfo  Boolean @default(false)
  showRecentPurchasesSection  Boolean @default(true)
  showFeaturedProductsSection Boolean @default(true)

  // Formas de pagamento aceitas
  acceptsPix            Boolean          @default(true)
  acceptsCash           Boolean          @default(true)
  acceptsCardOnDelivery Boolean          @default(true)
  paymentMode           StorePaymentMode @default(MANUAL)

  // Pix
  pixKeyType      PixKeyType?
  pixKey          String?
  pixRecipient    String?
  pixBank         String?
  pixInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model StoreSlugRedirect {
  id          String   @id @default(uuid())
  tenantId    String
  storeId     String
  oldSlug     String   @unique
  createdById String?
  createdAt   DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store  @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy User?  @relation("StoreSlugRedirectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, storeId, createdAt])
  @@index([createdById])
  @@map("store_slug_redirects")
}

model StoreCustomization {
  id                    String                       @id @default(uuid())
  tenantId              String
  storeId               String                       @unique
  schemaVersion         Int                          @default(2)
  publishedConfig       Json
  draftConfig           Json?
  draftVersion          Int                          @default(0)
  publishedVersion      Int                          @default(0)
  publishedAt           DateTime?
  publishedById         String?
  updatedById           String?
  draftOrigin           CustomizationRevisionOrigin?
  draftSourceRevisionId String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  store       Store                        @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  publishedBy User?                        @relation("CustomizationPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  updatedBy   User?                        @relation("CustomizationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  revisions   StoreCustomizationRevision[]

  @@unique([id, tenantId, storeId])
  @@unique([storeId, tenantId])
  @@index([tenantId])
  @@index([publishedById])
  @@index([updatedById])
  @@index([draftSourceRevisionId])
  @@map("store_customizations")
}

model StoreCustomizationRevision {
  id              String                      @id @default(uuid())
  customizationId String
  tenantId        String
  storeId         String
  version         Int
  schemaVersion   Int                         @default(2)
  snapshot        Json
  actorUserId     String?
  action          CustomizationRevisionAction @default(PUBLISHED)
  reason          String
  origin          CustomizationRevisionOrigin
  createdAt       DateTime                    @default(now())
  publishedAt     DateTime

  customization StoreCustomization @relation(fields: [customizationId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  actor         User?              @relation("CustomizationRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([storeId, version])
  @@index([customizationId])
  @@index([tenantId, storeId])
  @@index([actorUserId])
  @@index([storeId, createdAt, id])
  @@map("store_customization_revisions")
}

model StoreAsset {
  id          String           @id @default(uuid())
  tenantId    String
  storeId     String
  assetType   StoreAssetType
  objectKey   String           @unique
  mimeType    String
  width       Int
  height      Int
  sizeBytes   Int
  altText     String
  status      StoreAssetStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  store         Store         @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy     User?         @relation("StoreAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  banners       StoreBanner[]
  productImages Product[]     @relation("ProductImageAsset")

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, status, createdAt])
  @@index([storeId, assetType, status])
  @@index([createdById])
  @@index([deletedAt])
  @@map("store_assets")
}

model StoreBanner {
  id               String                @id @default(uuid())
  tenantId         String
  storeId          String
  assetId          String?
  title            String
  subtitle         String?
  buttonText       String?
  destinationType  BannerDestinationType @default(NONE)
  destinationValue String?
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean               @default(false)
  priority         Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  store Store       @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  asset StoreAsset? @relation(fields: [assetId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, isActive, priority])
  @@index([storeId, startsAt, endsAt])
  @@index([assetId])
  @@map("store_banners")
}

model StoreDomain {
  id                String            @id @default(uuid())
  tenantId          String
  storeId           String
  hostname          String            @unique
  domainType        StoreDomainType
  status            StoreDomainStatus @default(PENDING)
  verificationToken String            @unique
  isPrimary         Boolean           @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  store Store @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, status])
  @@index([storeId, isPrimary])
  @@map("store_domains")
}

model StoreEntitlement {
  id                             String    @id @default(uuid())
  tenantId                       String
  storeId                        String    @unique
  maxAssetCount                  Int       @default(25)
  maxAssetStorageBytes           Int       @default(52428800)
  maxBanners                     Int       @default(5)
  allowedLayoutTemplates         String[]  @default(["CLASSIC_LIST", "MODERN_GRID", "EDITORIAL_HERO"])
  allowedVisualPresets           String[]  @default(["CLASSIC", "MODERN", "MINIMALIST", "BURGER", "PIZZA", "ACAI_DESSERT", "EXECUTIVE_RESTAURANT", "DARK_PREMIUM"])
  advancedTypographyEnabled      Boolean   @default(true)
  customDomainEnabled            Boolean   @default(false)
  platformBrandingRemovalEnabled Boolean   @default(false)
  scheduledBannersEnabled        Boolean   @default(false)
  onlinePaymentsEnabled          Boolean   @default(false)
  operationalSlaEnabled          Boolean   @default(false)
  operationalSlaEnabledAt        DateTime?
  kdsEnabled                     Boolean   @default(false)
  advancedReportsEnabled         Boolean   @default(false)
  orderPrintingEnabled           Boolean   @default(false)
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  store Store @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId, storeId])
  @@unique([storeId, tenantId])
  @@index([tenantId, storeId])
  @@map("store_entitlements")
}

model StoreAddress {
  id           String  @id @default(uuid())
  storeId      String  @unique
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_addresses")
}

model OpeningHour {
  id        String    @id @default(uuid())
  storeId   String
  dayOfWeek DayOfWeek
  openTime  String // "08:00"
  closeTime String // "23:00"
  isActive  Boolean   @default(true)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
  @@index([storeId])
  @@map("opening_hours")
}

model StoreScheduleException {
  id          String                     @id @default(uuid())
  tenantId    String
  storeId     String
  date        DateTime                   @db.Date
  type        StoreScheduleExceptionType
  openTime    String?
  closeTime   String?
  reason      String?
  createdById String
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store  @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy User   @relation("StoreScheduleExceptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([storeId, date])
  @@index([tenantId, storeId, date])
  @@index([createdById])
  @@map("store_schedule_exceptions")
}

// =============================================================================
// Catálogo
// =============================================================================

model Category {
  id            String    @id @default(uuid())
  tenantId      String
  storeId       String
  name          String
  description   String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  version       Int       @default(0)
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId, storeId, archivedAt, sortOrder])
  @@index([storeId, isActive, archivedAt])
  @@index([tenantId])
  @@index([storeId])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id            String    @id @default(uuid())
  tenantId      String
  storeId       String
  categoryId    String
  name          String
  description   String?
  imageUrl      String? // Legado — preferir imageAssetId
  imageAssetId  String? // FK para StoreAsset (PRODUCT_IMAGE)
  basePrice     Int // Em centavos
  isAvailable   Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  isSoldOut     Boolean   @default(false)
  allowNotes    Boolean   @default(true)
  sortOrder     Int       @default(0)
  version       Int       @default(0)
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageAsset   StoreAsset?          @relation("ProductImageAsset", fields: [imageAssetId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)
  optionGroups ProductOptionGroup[]

  @@index([tenantId, storeId, categoryId, archivedAt, sortOrder])
  @@index([storeId, isAvailable, isSoldOut, archivedAt])
  @@index([categoryId, archivedAt, sortOrder])
  @@index([storeId, updatedAt])
  @@index([imageAssetId, tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
  @@index([categoryId])
  @@index([sortOrder])
  @@index([isAvailable])
  @@map("products")
}

model ProductOptionGroup {
  id            String    @id @default(uuid())
  productId     String
  title         String
  description   String?
  isRequired    Boolean   @default(false)
  isMultiple    Boolean   @default(false)
  minSelections Int       @default(0)
  maxSelections Int       @default(1)
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  version       Int       @default(0)
  archivedAt    DateTime?
  archivedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId, archivedAt, sortOrder])
  @@index([productId])
  @@index([sortOrder])
  @@map("product_option_groups")
}

model ProductOption {
  id           String    @id @default(uuid())
  groupId      String
  name         String
  price        Int       @default(0) // Preço adicional em centavos
  isAvailable  Boolean   @default(true)
  sortOrder    Int       @default(0)
  version      Int       @default(0)
  archivedAt   DateTime?
  archivedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, archivedAt, sortOrder])
  @@index([groupId])
  @@index([sortOrder])
  @@map("product_options")
}

// =============================================================================
// Entrega
// =============================================================================

model DeliveryZone {
  id            String   @id @default(uuid())
  tenantId      String
  storeId       String
  name          String
  fee           Int      @default(0) // Taxa em centavos
  minOrderValue Int? // Pedido mínimo em centavos (opcional)
  estimatedTime String? // Ex: "30-40 min"
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store               Store                     @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  postalRanges        DeliveryZonePostalRange[]
  customerAddressUses CustomerAddressStoreUse[]

  @@unique([id, tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
  @@index([sortOrder])
  @@map("delivery_zones")
}

model DeliveryZonePostalRange {
  id              String   @id @default(uuid())
  tenantId        String
  storeId         String
  deliveryZoneId  String
  postalCodeStart String   @db.Char(8)
  postalCodeEnd   String   @db.Char(8)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deliveryZone DeliveryZone @relation(fields: [deliveryZoneId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@unique([deliveryZoneId, postalCodeStart, postalCodeEnd], map: "delivery_zone_postal_ranges_zone_start_end_key")
  @@index([tenantId, storeId, isActive])
  @@index([deliveryZoneId, isActive])
  @@index([storeId, postalCodeStart, postalCodeEnd])
  @@map("delivery_zone_postal_ranges")
}

// =============================================================================
// Clientes
// =============================================================================

model Customer {
  id                 String    @id @default(uuid())
  tenantId           String
  name               String
  phone              String
  phoneNormalized    String    @db.VarChar(13)
  lastOrderAt        DateTime?
  recognitionEnabled Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant                       Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses                    CustomerAddress[]
  orders                       Order[]
  recognitionSessions          CheckoutRecognitionSession[]
  recognitionAddressReferences CheckoutRecognitionAddressReference[]
  deviceRecognitions           CustomerDeviceRecognition[]

  @@unique([tenantId, phone])
  @@unique([id, tenantId])
  @@unique([tenantId, phoneNormalized])
  @@index([tenantId])
  @@index([phone])
  @@map("customers")
}

model CustomerAddress {
  id                 String               @id @default(uuid())
  tenantId           String
  customerId         String
  label              CustomerAddressLabel @default(OTHER)
  street             String
  number             String
  complement         String?
  neighborhood       String
  city               String
  state              String
  zipCode            String?
  reference          String?
  addressFingerprint String               @db.Char(64)
  isDefault          Boolean              @default(false)
  lastUsedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  customer              Customer                              @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  storeUses             CustomerAddressStoreUse[]
  recognitionReferences CheckoutRecognitionAddressReference[]

  @@unique([id, tenantId])
  @@unique([customerId, addressFingerprint])
  @@index([tenantId])
  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerAddressStoreUse {
  id                String   @id @default(uuid())
  tenantId          String
  storeId           String
  customerAddressId String
  deliveryZoneId    String
  lastUsedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store           Store           @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customerAddress CustomerAddress @relation(fields: [customerAddressId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deliveryZone    DeliveryZone    @relation(fields: [deliveryZoneId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@unique([customerAddressId, storeId])
  @@index([tenantId, storeId, lastUsedAt])
  @@index([deliveryZoneId, tenantId, storeId])
  @@map("customer_address_store_uses")
}

model CheckoutRecognitionSession {
  id                  String                               @id @default(uuid())
  tokenHash           String                               @unique @db.Char(64)
  tenantId            String
  storeId             String
  customerId          String?
  deviceRecognitionId String?
  attemptCount        Int                                  @default(0)
  consecutiveFailures Int                                  @default(0)
  nextAttemptAt       DateTime?
  blockedUntil        DateTime?
  confirmedAt         DateTime?
  confirmationMode    CheckoutRecognitionConfirmationMode?
  expiresAt           DateTime
  invalidatedAt       DateTime?
  consumedAt          DateTime?
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt

  store             Store                                 @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customer          Customer?                             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deviceRecognition CustomerDeviceRecognition?            @relation(fields: [deviceRecognitionId], references: [id], onDelete: SetNull)
  addressReferences CheckoutRecognitionAddressReference[]

  @@index([tenantId, storeId, expiresAt])
  @@index([customerId, expiresAt])
  @@index([deviceRecognitionId, expiresAt])
  @@index([expiresAt])
  @@map("checkout_recognition_sessions")
}

model StorefrontDevice {
  id         String   @id @default(uuid())
  tokenHash  String   @unique @db.Char(64)
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recognitions CustomerDeviceRecognition[]

  @@index([expiresAt])
  @@map("storefront_devices")
}

model CustomerDeviceRecognition {
  id                 String    @id @default(uuid())
  storefrontDeviceId String
  tenantId           String
  storeId            String
  customerId         String
  lastUsedAt         DateTime  @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  storefrontDevice    StorefrontDevice             @relation(fields: [storefrontDeviceId], references: [id], onDelete: Cascade)
  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store               Store                        @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customer            Customer                     @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  recognitionSessions CheckoutRecognitionSession[]

  @@unique([storefrontDeviceId, storeId])
  @@unique([id, tenantId, storeId, customerId])
  @@index([tenantId, storeId, expiresAt])
  @@index([customerId, storeId, revokedAt, lastUsedAt])
  @@index([storefrontDeviceId, expiresAt])
  @@map("customer_device_recognitions")
}

model CheckoutRecognitionAddressReference {
  id                   String    @id @default(uuid())
  referenceHash        String    @unique @db.Char(64)
  recognitionSessionId String
  tenantId             String
  storeId              String
  customerId           String
  customerAddressId    String
  addressUpdatedAt     DateTime
  confirmedAt          DateTime?
  expiresAt            DateTime
  invalidatedAt        DateTime?
  consumedAt           DateTime?
  createdAt            DateTime  @default(now())

  recognitionSession CheckoutRecognitionSession @relation(fields: [recognitionSessionId], references: [id], onDelete: Cascade)
  store              Store                      @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customer           Customer                   @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customerAddress    CustomerAddress            @relation(fields: [customerAddressId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([recognitionSessionId, expiresAt])
  @@index([tenantId, storeId, expiresAt])
  @@index([customerAddressId, expiresAt])
  @@map("checkout_recognition_address_references")
}

model CustomerRecognitionThrottle {
  id              String                           @id @default(uuid())
  tenantId        String
  storeId         String?
  scope           CustomerRecognitionThrottleScope
  keyHash         String                           @db.Char(64)
  failureCount    Int                              @default(0)
  windowStartedAt DateTime                         @default(now())
  nextAttemptAt   DateTime?
  blockedUntil    DateTime?
  expiresAt       DateTime
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store? @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, scope, keyHash])
  @@index([expiresAt])
  @@index([tenantId, storeId, blockedUntil])
  @@map("customer_recognition_throttles")
}

// =============================================================================
// Pedidos
// =============================================================================

model StoreOrderCounter {
  storeId    String @id
  lastNumber Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_order_counters")
}

model Order {
  id                     String    @id @default(uuid())
  tenantId               String
  storeId                String
  customerId             String?
  orderNumber            Int       @default(0)
  idempotencyKey         String
  idempotencyFingerprint String?
  quoteFingerprint       String?   @db.VarChar(64)
  publicToken            String    @unique @default(uuid())
  publicTokenExpiresAt   DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP + '30 days'::interval)"))
  paymentReportToken     String?   @unique @default(dbgenerated("(gen_random_uuid())::text"))
  paymentReportExpiresAt DateTime? @default(dbgenerated("(CURRENT_TIMESTAMP + '7 days'::interval)"))

  // Dados do cliente (snapshot)
  customerName            String
  customerPhone           String
  customerPhoneNormalized String?

  // Modalidade e endereço
  modality                 OrderModality
  deliveryAddress          String?
  deliveryZoneName         String?
  deliveryPostalCode       String?       @db.VarChar(8)
  deliveryStreet           String?       @db.VarChar(160)
  deliveryNumber           String?       @db.VarChar(30)
  deliveryComplement       String?       @db.VarChar(120)
  deliveryNeighborhood     String?       @db.VarChar(120)
  deliveryCity             String?       @db.VarChar(120)
  deliveryState            String?       @db.VarChar(2)
  deliveryReference        String?       @db.VarChar(200)
  promisedFulfillmentMinAt DateTime?
  promisedFulfillmentMaxAt DateTime?
  operationalStartedAt     DateTime?

  // Valores (em centavos)
  subtotal    Int
  discount    Int @default(0)
  deliveryFee Int @default(0)
  total       Int

  // Pagamento
  paymentMethod PaymentMethodType
  changeFor     Int? // Troco para (em centavos)

  // Status
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  version         Int           @default(0)
  statusChangedAt DateTime      @default(now())

  acceptedAt   DateTime?
  preparingAt  DateTime?
  readyAt      DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?

  cancelledById                      String?
  cancellationReasonCode             OrderCancellationReasonCode?
  cancellationNote                   String?                      @db.VarChar(500)
  cancellationSource                 OrderChangeSource?
  customerCancellationNoticeRequired Boolean?

  // Observações
  notes String?

  // Cupom
  couponId   String?
  couponCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store       Store     @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cancelledBy User?     @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  items                         OrderItem[]
  statusHistory                 OrderStatusHistory[]
  internalNotes                 OrderInternalNote[]
  payment                       Payment?
  outboxEvents                  OrderOutboxEvent[]
  paymentHistory                PaymentStatusHistory[]
  couponUsages                  CouponUsage[]
  couponReservation             CouponReservation?
  pushSubscriptions             OrderPushSubscription[]
  webPushDispatches             WebPushDispatch[]
  webPushDeliveries             WebPushDelivery[]
  storeWebPushDispatches        StoreWebPushDispatch[]
  storeWebPushDeliveries        StoreWebPushDelivery[]
  operationalSlaAlerts          OrderOperationalSlaAlert[]
  mercadoPagoPayment            MercadoPagoPayment?
  orderOperationalSlaDeliveries OrderOperationalSlaDelivery[]

  @@unique([storeId, idempotencyKey])
  @@unique([storeId, orderNumber])
  @@unique([id, tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([customerId])
  @@index([cancelledById])
  @@index([publicToken])
  @@index([publicTokenExpiresAt])
  @@index([tenantId, storeId, createdAt, id])
  @@index([storeId, status, createdAt, id])
  @@index([storeId, paymentStatus, createdAt, id])
  @@index([storeId, status, statusChangedAt, id])
  @@index([storeId, customerPhoneNormalized, createdAt, id])
  @@map("orders")
}

model OrderInternalNote {
  id           String    @id @default(uuid())
  tenantId     String
  storeId      String
  orderId      String
  authorUserId String
  body         String    @db.VarChar(1000)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  order  Order @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  author User  @relation("OrderInternalNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt, id])
  @@index([tenantId, storeId, createdAt, id])
  @@map("order_internal_notes")
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String
  position Int    @default(0)

  // Snapshot do produto no momento do pedido
  productId    String
  productName  String
  unitPrice    Int // Em centavos
  quantity     Int
  notes        String?
  itemTotal    Int // Em centavos (unitPrice * quantity + opções)
  imageUrl     String? // Snapshot da URL legada no momento da compra
  imageAssetId String? // Snapshot do StoreAsset no momento da compra

  order   Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  options OrderItemOption[]

  @@index([orderId, position, id])
  @@index([productId])
  @@index([imageAssetId])
  @@map("order_items")
}

model OrderItemOption {
  id          String @id @default(uuid())
  orderItemId String
  position    Int    @default(0)

  // Snapshot da opção no momento do pedido
  optionId      String
  optionName    String
  optionPrice   Int // Em centavos
  groupId       String?
  groupName     String?
  groupPosition Int     @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId, groupPosition, position, id])
  @@map("order_item_options")
}

model OrderStatusHistory {
  id                String                       @id @default(uuid())
  orderId           String
  fromStatus        OrderStatus?
  toStatus          OrderStatus
  note              String?
  changedBy         String? // legado: userId ou "system"
  changedById       String?
  actorNameSnapshot String?
  source            OrderChangeSource            @default(SYSTEM)
  reasonCode        OrderCancellationReasonCode?
  versionFrom       Int?
  versionTo         Int?
  isUndo            Boolean                      @default(false)
  revertsHistoryId  String?                      @unique
  createdAt         DateTime                     @default(now())

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderId, createdAt, id])
  @@index([changedById, createdAt])
  @@index([createdAt])
  @@map("order_status_history")
}

// =============================================================================
// Pagamento
// =============================================================================

model Payment {
  id                String            @id @default(uuid())
  orderId           String            @unique
  method            PaymentMethodType
  provider          PaymentProvider?
  status            PaymentStatus     @default(PENDING)
  amount            Int // Em centavos
  paidAt            DateTime?
  confirmedBy       String? // legado: userId que confirmou
  reportedAt        DateTime?
  failedAt          DateTime?
  failureReasonCode String?           @db.VarChar(64)
  failureNote       String?           @db.VarChar(500)
  cancelledAt       DateTime?
  refundedAt        DateTime?
  refundedBy        String?
  refundReasonCode  String?           @db.VarChar(64)
  refundNote        String?           @db.VarChar(500)
  refundAmount      Int?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  statusHistory      PaymentStatusHistory[]
  mercadoPagoPayment MercadoPagoPayment?

  @@unique([id, orderId])
  @@index([status])
  @@map("payments")
}

model StorePaymentProviderConnection {
  id                     String                          @id @default(uuid())
  tenantId               String
  storeId                String
  provider               PaymentProvider
  status                 PaymentProviderConnectionStatus @default(ERROR)
  providerUserId         String                          @db.VarChar(64)
  liveMode               Boolean
  scopes                 String[]                        @default([])
  accessTokenCiphertext  String?                         @db.Text
  accessTokenIv          String?                         @db.VarChar(64)
  refreshTokenCiphertext String?                         @db.Text
  refreshTokenIv         String?                         @db.VarChar(64)
  tokenExpiresAt         DateTime?
  credentialVersion      Int                             @default(1)
  refreshLeaseId         String?                         @db.Uuid
  refreshLeaseExpiresAt  DateTime?
  connectedAt            DateTime?
  refreshedAt            DateTime?
  disconnectedAt         DateTime?
  reauthRequiredAt       DateTime?
  lastErrorCode          String?                         @db.VarChar(64)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store               Store                @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  mercadoPagoPayments MercadoPagoPayment[]

  @@unique([storeId, provider])
  @@unique([id, tenantId, storeId])
  @@index([provider, providerUserId])
  @@index([tenantId, storeId, status])
  @@index([refreshLeaseExpiresAt])
  @@map("store_payment_provider_connections")
}

model PaymentProviderOAuthAttempt {
  id                     String          @id @default(uuid())
  tenantId               String
  storeId                String
  provider               PaymentProvider
  initiatedById          String
  stateHash              String          @unique @db.VarChar(64)
  codeVerifierCiphertext String?         @db.Text
  codeVerifierIv         String?         @db.VarChar(64)
  credentialVersion      Int             @default(1)
  returnPath             String          @db.VarChar(500)
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime        @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store       Store  @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  initiatedBy User   @relation("PaymentProviderOAuthAttemptInitiatedBy", fields: [initiatedById], references: [id], onDelete: Cascade)

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, provider, createdAt])
  @@index([expiresAt, consumedAt])
  @@index([initiatedById])
  @@map("payment_provider_oauth_attempts")
}

model MercadoPagoPayment {
  id                   String                    @id @default(uuid())
  tenantId             String
  storeId              String
  orderId              String                    @unique
  paymentId            String                    @unique
  connectionId         String
  creationStatus       MercadoPagoCreationStatus @default(PENDING)
  externalReference    String                    @unique @db.VarChar(150)
  idempotencyKey       String                    @unique @db.VarChar(150)
  providerOrderId      String?                   @unique @db.VarChar(100)
  providerPaymentId    String?                   @unique @db.VarChar(100)
  providerStatus       String?                   @db.VarChar(64)
  providerStatusDetail String?                   @db.VarChar(64)
  qrCode               String?                   @db.Text
  ticketUrl            String?                   @db.Text
  expiresAt            DateTime?
  payerEmailCiphertext String?                   @db.Text
  payerEmailIv         String?                   @db.VarChar(64)
  credentialVersion    Int                       @default(1)
  lastErrorCode        String?                   @db.VarChar(64)
  lastSyncedAt         DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  tenant     Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store      Store                          @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order      Order                          @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  payment    Payment                        @relation(fields: [paymentId, orderId], references: [id, orderId], onDelete: Cascade)
  connection StorePaymentProviderConnection @relation(fields: [connectionId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)

  @@unique([id, tenantId, storeId])
  @@unique([orderId, tenantId, storeId])
  @@unique([paymentId, orderId])
  @@index([tenantId, storeId, creationStatus])
  @@index([connectionId, createdAt])
  @@index([providerStatus, providerStatusDetail])
  @@map("mercado_pago_payments")
}

model PaymentProviderWebhookEvent {
  id                  String          @id @default(uuid())
  provider            PaymentProvider
  providerEventId     String          @db.VarChar(150)
  topic               String          @db.VarChar(32)
  action              String          @db.VarChar(64)
  providerUserId      String?         @db.VarChar(100)
  providerObjectId    String?         @db.VarChar(150)
  attempts            Int             @default(0)
  availableAt         DateTime        @default(now())
  processingStartedAt DateTime?
  lastErrorCode       String?         @db.VarChar(64)
  processedAt         DateTime?
  createdAt           DateTime        @default(now())

  @@unique([provider, providerEventId])
  @@index([provider, providerUserId, createdAt])
  @@index([provider, processedAt, availableAt, createdAt])
  @@map("payment_provider_webhook_events")
}

model PaymentProviderAlert {
  id                   String                       @id @default(uuid())
  provider             PaymentProvider
  dedupeKey            String                       @db.VarChar(200)
  priority             PaymentProviderAlertPriority
  status               PaymentProviderAlertStatus   @default(OPEN)
  tenantId             String?
  storeId              String?
  orderId              String?
  paymentId            String?
  mercadoPagoPaymentId String?
  code                 String                       @db.VarChar(64)
  occurrenceCount      Int                          @default(1)
  firstOccurredAt      DateTime                     @default(now())
  lastOccurredAt       DateTime                     @default(now())
  resolvedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@unique([provider, dedupeKey])
  @@index([status, priority, lastOccurredAt])
  @@index([tenantId, storeId, status, lastOccurredAt])
  @@index([orderId])
  @@index([paymentId])
  @@map("payment_provider_alerts")
}

model PaymentStatusHistory {
  id                String            @id @default(uuid())
  tenantId          String
  storeId           String
  orderId           String
  paymentId         String
  fromStatus        PaymentStatus?
  toStatus          PaymentStatus
  changedById       String?
  actorNameSnapshot String?
  source            OrderChangeSource
  reasonCode        String?           @db.VarChar(64)
  note              String?           @db.VarChar(500)
  orderVersionFrom  Int?
  orderVersionTo    Int?
  createdAt         DateTime          @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store   @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order     Order   @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  payment   Payment @relation(fields: [paymentId, orderId], references: [id, orderId], onDelete: Cascade)
  changedBy User?   @relation("PaymentStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([paymentId, orderVersionTo, toStatus])
  @@index([paymentId, createdAt, id])
  @@index([orderId, createdAt, id])
  @@index([changedById, createdAt])
  @@index([tenantId, storeId])
  @@map("payment_status_history")
}

model OrderOutboxEvent {
  /// Partial SQL-managed retention index:
  /// order_outbox_events_processed_retention_idx ON processedAt WHERE status = 'PROCESSED'.
  /// Partial SQL-managed Web Push projection index:
  /// order_outbox_events_web_push_projection_idx ON occurredAt, id for eligible event types.
  id               String               @id @default(uuid())
  tenantId         String
  storeId          String
  orderId          String
  auditLogId       String?              @unique
  eventType        OrderOutboxEventType
  aggregateVersion Int
  schemaVersion    Int                  @default(1)
  payload          Json
  status           OrderOutboxStatus    @default(PENDING)
  attempts         Int                  @default(0)
  availableAt      DateTime             @default(now())
  queuedAt         DateTime?
  lockedAt         DateTime?
  lockToken        String?              @db.Uuid
  processedAt      DateTime?
  failedAt         DateTime?
  lastError        String?              @db.VarChar(1000)
  occurredAt       DateTime
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                  Store                  @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order                  Order                  @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  auditLog               AuditLog?              @relation(fields: [auditLogId], references: [id], onDelete: SetNull)
  webPushDispatch        WebPushDispatch?
  webPushDeliveries      WebPushDelivery[]
  storeWebPushDispatch   StoreWebPushDispatch?
  storeWebPushDeliveries StoreWebPushDelivery[]

  @@unique([orderId, eventType, aggregateVersion])
  @@unique([id, tenantId, storeId])
  @@index([status, availableAt, createdAt])
  @@index([storeId, createdAt, id])
  @@index([orderId, createdAt, id])
  @@index([queuedAt, processedAt])
  @@map("order_outbox_events")
}

model WebPushSubscription {
  id             String    @id @default(uuid())
  endpoint       String    @db.VarChar(4096)
  endpointHash   String    @unique @db.VarChar(64)
  p256dh         String    @db.VarChar(256)
  auth           String    @db.VarChar(128)
  origin         String    @db.VarChar(255)
  expirationTime DateTime?
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  revokedReason  String?   @db.VarChar(120)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders                   OrderPushSubscription[]
  deliveries               WebPushDelivery[]
  storeStaffSubscriptions  StoreStaffPushSubscription[]
  storeDeliveries          StoreWebPushDelivery[]
  operationalSlaDeliveries OrderOperationalSlaDelivery[]

  @@index([revokedAt, lastSeenAt])
  @@index([revokedAt, expirationTime])
  @@map("web_push_subscriptions")
}

model OrderPushSubscription {
  id                    String    @id @default(uuid())
  tenantId              String
  storeId               String
  orderId               String
  webPushSubscriptionId String
  enabledAt             DateTime  @default(now())
  disabledAt            DateTime?
  terminalNotifiedAt    DateTime?
  lockedAt              DateTime?
  lockToken             String?   @db.Uuid
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store               @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order        Order               @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  subscription WebPushSubscription @relation(fields: [webPushSubscriptionId], references: [id], onDelete: Cascade)
  deliveries   WebPushDelivery[]

  @@unique([orderId, webPushSubscriptionId])
  @@unique([id, tenantId, storeId, orderId])
  @@index([tenantId, storeId, disabledAt])
  @@index([webPushSubscriptionId, disabledAt])
  @@map("order_push_subscriptions")
}

model WebPushDispatch {
  id                 String                @id @default(uuid())
  tenantId           String
  storeId            String
  orderId            String
  orderOutboxEventId String                @unique
  status             WebPushDispatchStatus @default(PENDING)
  attempts           Int                   @default(0)
  availableAt        DateTime              @default(now())
  lockedAt           DateTime?
  lockToken          String?               @db.Uuid
  processedAt        DateTime?
  failedAt           DateTime?
  lastError          String?               @db.VarChar(1000)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store       Store             @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order       Order             @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  outboxEvent OrderOutboxEvent  @relation(fields: [orderOutboxEventId], references: [id], onDelete: Cascade)
  deliveries  WebPushDelivery[]

  @@unique([id, tenantId, storeId, orderId])
  @@index([status, availableAt, createdAt])
  @@index([orderId, createdAt])
  @@map("web_push_dispatches")
}

model WebPushDelivery {
  id                      String                @id @default(uuid())
  tenantId                String
  storeId                 String
  orderId                 String
  orderOutboxEventId      String
  webPushDispatchId       String
  orderPushSubscriptionId String
  webPushSubscriptionId   String
  orderStatus             OrderStatus
  aggregateVersion        Int
  status                  WebPushDeliveryStatus @default(PENDING)
  attempts                Int                   @default(0)
  availableAt             DateTime              @default(now())
  lockedAt                DateTime?
  lockToken               String?               @db.Uuid
  sentAt                  DateTime?
  failedAt                DateTime?
  lastStatusCode          Int?
  lastError               String?               @db.VarChar(1000)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store                 @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order             Order                 @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  outboxEvent       OrderOutboxEvent      @relation(fields: [orderOutboxEventId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  dispatch          WebPushDispatch       @relation(fields: [webPushDispatchId, tenantId, storeId, orderId], references: [id, tenantId, storeId, orderId], onDelete: Cascade)
  orderSubscription OrderPushSubscription @relation(fields: [orderPushSubscriptionId, tenantId, storeId, orderId], references: [id, tenantId, storeId, orderId], onDelete: Cascade)
  subscription      WebPushSubscription   @relation(fields: [webPushSubscriptionId], references: [id], onDelete: Cascade)

  @@unique([orderOutboxEventId, webPushSubscriptionId])
  @@index([status, availableAt, createdAt])
  @@index([orderPushSubscriptionId, aggregateVersion])
  @@index([webPushSubscriptionId, status])
  @@map("web_push_deliveries")
}

model StoreStaffPushSubscription {
