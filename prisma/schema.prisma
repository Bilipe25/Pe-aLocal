// =============================================================================
// Usuário e Sessão
// =============================================================================

model User {
  id            String       @id @default(uuid())
  authUserId    String?      @unique
  email         String       @unique
  name          String
  platformRole  PlatformRole @default(USER)
  passwordHash  String?
  isActive      Boolean      @default(true)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  sessions                  Session[]
  tenantMembers             TenantMember[]
  auditLogs                 AuditLog[]
  customizationsPublished   StoreCustomization[]          @relation("CustomizationPublishedBy")
  customizationsUpdated     StoreCustomization[]          @relation("CustomizationUpdatedBy")
  customizationRevisions    StoreCustomizationRevision[]  @relation("CustomizationRevisionActor")
  storeAssetsCreated        StoreAsset[]                  @relation("StoreAssetCreatedBy")
  scheduleExceptionsCreated StoreScheduleException[]      @relation("StoreScheduleExceptionCreatedBy")
  slugRedirectsCreated      StoreSlugRedirect[]           @relation("StoreSlugRedirectCreatedBy")
  ordersCancelled           Order[]                       @relation("OrderCancelledBy")
  ordersCreated             Order[]                       @relation("OrderCreatedBy")
  orderStatusChanges        OrderStatusHistory[]          @relation("OrderStatusChangedBy")
  orderInternalNotes        OrderInternalNote[]           @relation("OrderInternalNoteAuthor")
  paymentStatusChanges      PaymentStatusHistory[]        @relation("PaymentStatusChangedBy")
  paymentOAuthAttempts      PaymentProviderOAuthAttempt[] @relation("PaymentProviderOAuthAttemptInitiatedBy")
  diningSessionsClosed      DiningTableSession[]          @relation("DiningTableSessionClosedBy")
  diningRequestsResolved    DiningTableServiceRequest[]   @relation("DiningTableServiceRequestResolvedBy")
  posDraftsCreated          PosDraft[]                    @relation("PosDraftCreatedBy")
  posDiscountsApplied       PosManualDiscountLedger[]     @relation("PosManualDiscountAppliedBy")
  posDiscountsAuthorized    PosManualDiscountLedger[]     @relation("PosManualDiscountAuthorizedBy")

  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// =============================================================================
// Tenant (Estabelecimento)
// =============================================================================

model Tenant {
  id        String       @id @default(uuid())
  name      String
  document  String? // CNPJ/CPF
  status    TenantStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  members                        TenantMember[]
  stores                         Store[]
  categories                     Category[]
  products                       Product[]
  deliveryZones                  DeliveryZone[]
  deliveryPostalRanges           DeliveryZonePostalRange[]
  customers                      Customer[]
  deviceRecognitions             CustomerDeviceRecognition[]
  recognitionThrottles           CustomerRecognitionThrottle[]
  orders                         Order[]
  coupons                        Coupon[]
  storeCombos                    StoreCombo[]
  storeComboItems                StoreComboItem[]
  storeProductPromotions         StoreProductPromotion[]
  storeOffers                    StoreOffer[]
  orderOfferGroups               OrderOfferGroup[]
  orderPriceAdjustments          OrderPriceAdjustment[]
  auditLogs                      AuditLog[]
  orderOutboxEvents              OrderOutboxEvent[]
  operationalOutboxEvents        OperationalOutboxEvent[]
  paymentStatusHistory           PaymentStatusHistory[]
  slugRedirects                  StoreSlugRedirect[]
  scheduleExceptions             StoreScheduleException[]
  orderPushSubscriptions         OrderPushSubscription[]
  webPushDispatches              WebPushDispatch[]
  webPushDeliveries              WebPushDelivery[]
  storeStaffPushSubscriptions    StoreStaffPushSubscription[]
  storeWebPushDispatches         StoreWebPushDispatch[]
  storeWebPushDeliveries         StoreWebPushDelivery[]
  orderOperationalSlaAlerts      OrderOperationalSlaAlert[]
  orderOperationalSlaDeliveries  OrderOperationalSlaDelivery[]
  paymentProviderConnections     StorePaymentProviderConnection[]
  paymentOAuthAttempts           PaymentProviderOAuthAttempt[]
  mercadoPagoPayments            MercadoPagoPayment[]
  diningTables                   StoreDiningTable[]
  diningTableSessions            DiningTableSession[]
  diningTableServiceRequests     DiningTableServiceRequest[]
  posDrafts                      PosDraft[]
  posTerminals                   StorePosTerminal[]
  posShortcuts                   StorePosShortcut[]
  posManualDiscounts             PosManualDiscountLedger[]
  consumerVerificationChallenges ConsumerVerificationChallenge[]

  @@map("tenants")
}

model TenantMember {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  role      TenantRole
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeStaffPushSubscriptions StoreStaffPushSubscription[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_members")
}

// =============================================================================
// Loja
// =============================================================================

model Store {
  id                   String      @id @default(uuid())
  tenantId             String
  slug                 String      @unique
  name                 String
  description          String?
  phone                String?
  whatsapp             String?
  logoUrl              String?
  coverUrl             String?
  status               StoreStatus @default(CLOSED)
  isActive             Boolean     @default(true)
  timeZone             String      @default("America/Fortaleza")
  configurationVersion Int         @default(0)
  catalogVersion       Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings StoreSettings?

  address                        StoreAddress?
  openingHours                   OpeningHour[]
  scheduleExceptions             StoreScheduleException[]
  categories                     Category[]
  products                       Product[]
  deliveryZones                  DeliveryZone[]
  deliveryPostalRanges           DeliveryZonePostalRange[]
  customerAddressUses            CustomerAddressStoreUse[]
  recognitionSessions            CheckoutRecognitionSession[]
  recognitionAddressReferences   CheckoutRecognitionAddressReference[]
  deviceRecognitions             CustomerDeviceRecognition[]
  recognitionThrottles           CustomerRecognitionThrottle[]
  consumerVerificationChallenges ConsumerVerificationChallenge[]
  coupons                        Coupon[]
  combos                         StoreCombo[]
  comboItems                     StoreComboItem[]
  productPromotions              StoreProductPromotion[]
  offers                         StoreOffer[]
  orderOfferGroups               OrderOfferGroup[]
  orderPriceAdjustments          OrderPriceAdjustment[]
  orders                         Order[]
  orderCounter                   StoreOrderCounter?
  customization                  StoreCustomization?
  auditLogs                      AuditLog[]
  orderOutboxEvents              OrderOutboxEvent[]
  operationalOutboxEvents        OperationalOutboxEvent[]
  paymentStatusHistory           PaymentStatusHistory[]
  assets                         StoreAsset[]
  banners                        StoreBanner[]
  domains                        StoreDomain[]
  entitlement                    StoreEntitlement?
  slugRedirects                  StoreSlugRedirect[]
  orderPushSubscriptions         OrderPushSubscription[]
  webPushDispatches              WebPushDispatch[]
  webPushDeliveries              WebPushDelivery[]
  storeStaffPushSubscriptions    StoreStaffPushSubscription[]
  storeWebPushDispatches         StoreWebPushDispatch[]
  storeWebPushDeliveries         StoreWebPushDelivery[]
  orderOperationalSlaAlerts      OrderOperationalSlaAlert[]
  orderOperationalSlaDeliveries  OrderOperationalSlaDelivery[]
  paymentProviderConnections     StorePaymentProviderConnection[]
  paymentOAuthAttempts           PaymentProviderOAuthAttempt[]
  mercadoPagoPayments            MercadoPagoPayment[]
  diningTables                   StoreDiningTable[]
  diningTableSessions            DiningTableSession[]
  diningTableServiceRequests     DiningTableServiceRequest[]
  posDrafts                      PosDraft[]
  posTerminals                   StorePosTerminal[]
  posShortcuts                   StorePosShortcut[]
  posManualDiscounts             PosManualDiscountLedger[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([slug])
  @@index([status])
  @@map("stores")
}

model StoreSettings {
  id      String @id @default(uuid())
  storeId String @unique

  // Cores e aparência
  primaryColor   String @default("#f97316")
  secondaryColor String @default("#1e293b")
  fontFamily     String @default("Inter")

  // Configurações de pedido
  minOrderValue           Int     @default(0) // Em centavos
  estimatedTime           String  @default("30-50 min")
  estimatedTimeMinMinutes Int     @default(30)
  estimatedTimeMaxMinutes Int     @default(50)
  deliveryEnabled         Boolean @default(true)
  pickupEnabled           Boolean @default(true)

  // Exibição no cardápio público
  showEstimatedTimeInHero     Boolean @default(true)
  showFulfillmentInHero       Boolean @default(false)
  showMinOrderValueInHero     Boolean @default(true)
  showOpeningHoursInHero      Boolean @default(false)
  showFullAddressInStoreInfo  Boolean @default(false)
  showRecentPurchasesSection  Boolean @default(true)
  showFeaturedProductsSection Boolean @default(true)

  // Formas de pagamento aceitas
  acceptsPix            Boolean          @default(true)
  acceptsCash           Boolean          @default(true)
  acceptsCardOnDelivery Boolean          @default(true)
  acceptsCardInPerson   Boolean          @default(false)
  paymentMode           StorePaymentMode @default(MANUAL)

  // Pix
  pixKeyType      PixKeyType?
  pixKey          String?
  pixRecipient    String?
  pixBank         String?
  pixInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model StoreSlugRedirect {
  id          String   @id @default(uuid())
  tenantId    String
  storeId     String
  oldSlug     String   @unique
  createdById String?
  createdAt   DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store  @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy User?  @relation("StoreSlugRedirectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, storeId, createdAt])
  @@index([createdById])
  @@map("store_slug_redirects")
}

model StoreCustomization {
  id                    String                       @id @default(uuid())
  tenantId              String
  storeId               String                       @unique
  schemaVersion         Int                          @default(2)
  publishedConfig       Json
  draftConfig           Json?
  draftVersion          Int                          @default(0)
  publishedVersion      Int                          @default(0)
  publishedAt           DateTime?
  publishedById         String?
  updatedById           String?
  draftOrigin           CustomizationRevisionOrigin?
  draftSourceRevisionId String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  store       Store                        @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  publishedBy User?                        @relation("CustomizationPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  updatedBy   User?                        @relation("CustomizationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  revisions   StoreCustomizationRevision[]

  @@unique([id, tenantId, storeId])
  @@unique([storeId, tenantId])
  @@index([tenantId])
  @@index([publishedById])
  @@index([updatedById])
  @@index([draftSourceRevisionId])
  @@map("store_customizations")
}

model StoreCustomizationRevision {
  id              String                      @id @default(uuid())
  customizationId String
  tenantId        String
  storeId         String
  version         Int
  schemaVersion   Int                         @default(2)
  snapshot        Json
  actorUserId     String?
  action          CustomizationRevisionAction @default(PUBLISHED)
  reason          String
  origin          CustomizationRevisionOrigin
  createdAt       DateTime                    @default(now())
  publishedAt     DateTime

  customization StoreCustomization @relation(fields: [customizationId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  actor         User?              @relation("CustomizationRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([storeId, version])
  @@index([customizationId])
  @@index([tenantId, storeId])
  @@index([actorUserId])
  @@index([storeId, createdAt, id])
  @@map("store_customization_revisions")
}

model StoreAsset {
  id          String           @id @default(uuid())
  tenantId    String
  storeId     String
  assetType   StoreAssetType
  objectKey   String           @unique
  mimeType    String
  width       Int
  height      Int
  sizeBytes   Int
  altText     String
  status      StoreAssetStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  store         Store         @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy     User?         @relation("StoreAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  banners       StoreBanner[]
  productImages Product[]     @relation("ProductImageAsset")

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, status, createdAt])
  @@index([storeId, assetType, status])
  @@index([createdById])
  @@index([deletedAt])
  @@map("store_assets")
}

model StoreBanner {
  id               String                @id @default(uuid())
  tenantId         String
  storeId          String
  assetId          String?
  title            String
  subtitle         String?
  buttonText       String?
  destinationType  BannerDestinationType @default(NONE)
  destinationValue String?
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean               @default(false)
  priority         Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  store Store       @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  asset StoreAsset? @relation(fields: [assetId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, isActive, priority])
  @@index([storeId, startsAt, endsAt])
  @@index([assetId])
  @@map("store_banners")
}

model StoreDomain {
  id                String            @id @default(uuid())
  tenantId          String
  storeId           String
  hostname          String            @unique
  domainType        StoreDomainType
  status            StoreDomainStatus @default(PENDING)
  verificationToken String            @unique
  isPrimary         Boolean           @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  store Store @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, status])
  @@index([storeId, isPrimary])
  @@map("store_domains")
}

model StoreEntitlement {
  id                             String    @id @default(uuid())
  tenantId                       String
  storeId                        String    @unique
  maxAssetCount                  Int       @default(25)
  maxAssetStorageBytes           Int       @default(52428800)
  maxBanners                     Int       @default(5)
  allowedLayoutTemplates         String[]  @default(["CLASSIC_LIST", "MODERN_GRID", "EDITORIAL_HERO"])
  allowedVisualPresets           String[]  @default(["CLASSIC", "MODERN", "MINIMALIST", "BURGER", "PIZZA", "ACAI_DESSERT", "EXECUTIVE_RESTAURANT", "DARK_PREMIUM"])
  advancedTypographyEnabled      Boolean   @default(true)
  customDomainEnabled            Boolean   @default(false)
  platformBrandingRemovalEnabled Boolean   @default(false)
  scheduledBannersEnabled        Boolean   @default(false)
  onlinePaymentsEnabled          Boolean   @default(false)
  operationalSlaEnabled          Boolean   @default(false)
  operationalSlaEnabledAt        DateTime?
  kdsEnabled                     Boolean   @default(false)
  advancedReportsEnabled         Boolean   @default(false)
  orderPrintingEnabled           Boolean   @default(false)
  dineInQrEnabled                Boolean   @default(false)
  combosPromotionsEnabled        Boolean   @default(false)
  posEnabled                     Boolean   @default(false)
  consumerIdentityEnabled        Boolean   @default(false)
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  store Store @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId, storeId])
  @@unique([storeId, tenantId])
  @@index([tenantId, storeId])
  @@map("store_entitlements")
}

model StoreDiningTable {
  id              String   @id @default(uuid())
  tenantId        String
  storeId         String
  label           String   @db.VarChar(80)
  labelNormalized String   @db.VarChar(80)
  sortOrder       Int      @default(0)
  publicToken     String   @unique @db.VarChar(43)
  isActive        Boolean  @default(true)
  version         Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store                @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  orders   Order[]
  sessions DiningTableSession[]

  @@unique([id, tenantId, storeId])
  @@unique([tenantId, storeId, labelNormalized])
  @@index([tenantId, storeId, isActive, sortOrder, id])
  @@map("store_dining_tables")
}

model DiningTableSession {
  id            String                   @id @default(uuid())
  tenantId      String
  storeId       String
  diningTableId String
  publicToken   String                   @unique @db.VarChar(43)
  status        DiningTableSessionStatus @default(OPEN)
  version       Int                      @default(0)
  openedAt      DateTime                 @default(now())
  lastOrderAt   DateTime                 @default(now())
  closedAt      DateTime?
  closedById    String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store                       @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  diningTable     StoreDiningTable            @relation(fields: [diningTableId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)
  closedBy        User?                       @relation("DiningTableSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  orders          Order[]
  serviceRequests DiningTableServiceRequest[]

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, status, openedAt, id])
  @@index([tenantId, storeId, diningTableId, status])
  @@index([closedById])
  @@map("dining_table_sessions")
}

model DiningTableServiceRequest {
  id                   String                          @id @default(uuid())
  tenantId             String
  storeId              String
  diningTableSessionId String
  type                 DiningTableServiceRequestType
  status               DiningTableServiceRequestStatus @default(OPEN)
  idempotencyKey       String                          @db.VarChar(80)
  version              Int                             @default(0)
  createdAt            DateTime                        @default(now())
  resolvedAt           DateTime?
  resolvedById         String?
  updatedAt            DateTime                        @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store              Store              @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  diningTableSession DiningTableSession @relation(fields: [diningTableSessionId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  resolvedBy         User?              @relation("DiningTableServiceRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([id, tenantId, storeId])
  @@unique([diningTableSessionId, idempotencyKey])
  @@index([tenantId, storeId, status, createdAt, id])
  @@index([diningTableSessionId, status, createdAt, id])
  @@index([resolvedById])
  @@map("dining_table_service_requests")
}

model StoreAddress {
  id           String  @id @default(uuid())
  storeId      String  @unique
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zipCode      String

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_addresses")
}

model OpeningHour {
  id        String    @id @default(uuid())
  storeId   String
  dayOfWeek DayOfWeek
  openTime  String // "08:00"
  closeTime String // "23:00"
  isActive  Boolean   @default(true)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
  @@index([storeId])
  @@map("opening_hours")
}

model StoreScheduleException {
  id          String                     @id @default(uuid())
  tenantId    String
  storeId     String
  date        DateTime                   @db.Date
  type        StoreScheduleExceptionType
  openTime    String?
  closeTime   String?
  reason      String?
  createdById String
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store  @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy User   @relation("StoreScheduleExceptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([storeId, date])
  @@index([tenantId, storeId, date])
  @@index([createdById])
  @@map("store_schedule_exceptions")
}

// =============================================================================
// Catálogo
// =============================================================================

model Category {
  id            String    @id @default(uuid())
  tenantId      String
  storeId       String
  name          String
  description   String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  version       Int       @default(0)
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId, storeId, archivedAt, sortOrder])
  @@index([storeId, isActive, archivedAt])
  @@index([tenantId])
  @@index([storeId])
  @@index([sortOrder])
  @@map("categories")
}

model Product {
  id            String    @id @default(uuid())
  tenantId      String
  storeId       String
  categoryId    String
  name          String
  description   String?
  imageUrl      String? // Legado — preferir imageAssetId
  imageAssetId  String? // FK para StoreAsset (PRODUCT_IMAGE)
  basePrice     Int // Em centavos
  isAvailable   Boolean   @default(true)
  isFeatured    Boolean   @default(false)
  isSoldOut     Boolean   @default(false)
  allowNotes    Boolean   @default(true)
  sortOrder     Int       @default(0)
  version       Int       @default(0)
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store             Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category          Category                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageAsset        StoreAsset?             @relation("ProductImageAsset", fields: [imageAssetId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)
  optionGroups      ProductOptionGroup[]
  comboItems        StoreComboItem[]
  promotions        StoreProductPromotion[]
  offerComboChoices StoreOfferComboChoice[]
  posShortcuts      StorePosShortcut[]

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, categoryId, archivedAt, sortOrder])
  @@index([storeId, isAvailable, isSoldOut, archivedAt])
  @@index([categoryId, archivedAt, sortOrder])
  @@index([storeId, updatedAt])
  @@index([imageAssetId, tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
  @@index([categoryId])
  @@index([sortOrder])
  @@index([isAvailable])
  @@map("products")
}

model ProductOptionGroup {
  id            String    @id @default(uuid())
  productId     String
  title         String
  description   String?
  isRequired    Boolean   @default(false)
  isMultiple    Boolean   @default(false)
  minSelections Int       @default(0)
  maxSelections Int       @default(1)
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  version       Int       @default(0)
  archivedAt    DateTime?
  archivedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId, archivedAt, sortOrder])
  @@index([productId])
  @@index([sortOrder])
  @@map("product_option_groups")
}

model ProductOption {
  id           String    @id @default(uuid())
  groupId      String
  name         String
  price        Int       @default(0) // Preço adicional em centavos
  isAvailable  Boolean   @default(true)
  sortOrder    Int       @default(0)
  version      Int       @default(0)
  archivedAt   DateTime?
  archivedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, archivedAt, sortOrder])
  @@index([groupId])
  @@index([sortOrder])
  @@map("product_options")
}

// =============================================================================
// Ofertas — Combos e Promoções
// =============================================================================

model StoreCombo {
  id                 String      @id @default(uuid())
  tenantId           String
  storeId            String
  name               String      @db.VarChar(120)
  description        String?     @db.VarChar(500)
  specialPrice       Int
  isActive           Boolean     @default(true)
  sortOrder          Int         @default(0)
  version            Int         @default(0)
  startsOn           DateTime?   @db.Date
  endsOnExclusive    DateTime?   @db.Date
  weekdays           DayOfWeek[] @default([])
  startMinute        Int?
  endMinuteExclusive Int?
  archivedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store            @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  items  StoreComboItem[]

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, isActive, archivedAt, sortOrder])
  @@index([storeId, updatedAt])
  @@map("store_combos")
}

model StoreComboItem {
  id        String @id @default(uuid())
  tenantId  String
  storeId   String
  comboId   String
  productId String
  quantity  Int
  position  Int    @default(0)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store   Store      @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  combo   StoreCombo @relation(fields: [comboId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  product Product    @relation(fields: [productId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)

  @@unique([comboId, productId])
  @@index([comboId, position, id])
  @@index([tenantId, storeId, productId])
  @@map("store_combo_items")
}

model StoreProductPromotion {
  id                 String      @id @default(uuid())
  tenantId           String
  storeId            String
  productId          String
  promotionalPrice   Int
  isActive           Boolean     @default(true)
  version            Int         @default(0)
  startsOn           DateTime?   @db.Date
  endsOnExclusive    DateTime?   @db.Date
  weekdays           DayOfWeek[] @default([])
  startMinute        Int?
  endMinuteExclusive Int?
  archivedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product Product @relation(fields: [productId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, productId, isActive, archivedAt])
  @@index([storeId, updatedAt])
  @@map("store_product_promotions")
}

// Modelo canônico V2. As tabelas V1 permanecem durante a janela de rollback.
model StoreOffer {
  id                      String               @id @default(uuid())
  tenantId                String
  storeId                 String
  kind                    StoreOfferKind
  name                    String               @db.VarChar(120)
  description             String?              @db.VarChar(500)
  isActive                Boolean              @default(true)
  sortOrder               Int                  @default(0)
  version                 Int                  @default(0)
  modalities              StoreOfferModality[] @default([])
  startsOn                DateTime?            @db.Date
  endsOnExclusive         DateTime?            @db.Date
  weekdays                DayOfWeek[]          @default([])
  startMinute             Int?
  endMinuteExclusive      Int?
  maxTotalUses            Int?
  maxUsesPerCustomer      Int?
  maxApplicationsPerOrder Int                  @default(1)
  archivedAt              DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  combo         StoreOfferCombo?
  productPrice  StoreOfferProductPrice?
  quantityPrice StoreOfferQuantityPrice?
  bogo          StoreOfferBogo?
  cartDiscount  StoreOfferCartDiscount?
  freeDelivery  StoreOfferFreeDelivery?
  usages        StoreOfferUsage[]
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store         Store                    @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  posShortcuts  StorePosShortcut[]

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, isActive, archivedAt, sortOrder, id])
  @@index([tenantId, storeId, kind, updatedAt, id])
  @@map("store_offers")
}

model StoreOfferCombo {
  offerId    String @id
  tenantId   String
  storeId    String
  fixedPrice Int

  offer  StoreOffer             @relation(fields: [offerId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  groups StoreOfferComboGroup[]

  @@unique([offerId, tenantId, storeId])
  @@map("store_offer_combos")
}

model StoreOfferComboGroup {
  id       String @id @default(uuid())
  offerId  String
  tenantId String
  storeId  String
  name     String @db.VarChar(80)
  quantity Int    @default(1)
  position Int    @default(0)

  combo   StoreOfferCombo         @relation(fields: [offerId, tenantId, storeId], references: [offerId, tenantId, storeId], onDelete: Cascade)
  choices StoreOfferComboChoice[]

  @@unique([id, tenantId, storeId])
  @@unique([offerId, position])
  @@index([offerId, position, id])
  @@map("store_offer_combo_groups")
}

model StoreOfferComboChoice {
  id         String @id @default(uuid())
  groupId    String
  tenantId   String
  storeId    String
  productId  String
  priceDelta Int    @default(0)
  position   Int    @default(0)

  group   StoreOfferComboGroup @relation(fields: [groupId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  product Product              @relation(fields: [productId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)

  @@unique([groupId, productId])
  @@index([groupId, position, id])
  @@index([productId])
  @@map("store_offer_combo_choices")
}

model StoreOfferProductPrice {
  offerId    String @id
  tenantId   String
  storeId    String
  productId  String
  fixedPrice Int

  offer StoreOffer @relation(fields: [offerId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@unique([offerId, tenantId, storeId])
  @@index([productId])
  @@map("store_offer_product_prices")
}

model StoreOfferQuantityPrice {
  offerId          String @id
  tenantId         String
  storeId          String
  productId        String
  requiredQuantity Int
  groupFixedPrice  Int

  offer StoreOffer @relation(fields: [offerId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@unique([offerId, tenantId, storeId])
  @@index([productId])
  @@map("store_offer_quantity_prices")
}

model StoreOfferBogo {
  offerId     String @id
  tenantId    String
  storeId     String
  productId   String
  buyQuantity Int
  getQuantity Int

  offer StoreOffer @relation(fields: [offerId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@unique([offerId, tenantId, storeId])
  @@index([productId])
  @@map("store_offer_bogos")
}

model StoreOfferCartDiscount {
  offerId      String                 @id
  tenantId     String
  storeId      String
  discountType StoreOfferDiscountType
  value        Int
  minSubtotal  Int                    @default(0)
  maxDiscount  Int?

  offer StoreOffer @relation(fields: [offerId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@unique([offerId, tenantId, storeId])
  @@map("store_offer_cart_discounts")
}

model StoreOfferFreeDelivery {
  offerId     String @id
  tenantId    String
  storeId     String
  minSubtotal Int    @default(0)

  offer StoreOffer @relation(fields: [offerId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@unique([offerId, tenantId, storeId])
  @@map("store_offer_free_deliveries")
}

model StoreOfferUsage {
  id               String                @id @default(uuid())
  tenantId         String
  storeId          String
  offerId          String
  orderId          String
  customerId       String?
  status           StoreOfferUsageStatus @default(RESERVED)
  applicationCount Int                   @default(1)
  discountAmount   Int
  expiresAt        DateTime?
  consumedAt       DateTime?
  releasedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  offer StoreOffer @relation(fields: [offerId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@unique([offerId, orderId])
  @@index([tenantId, storeId, status, expiresAt])
  @@index([offerId, status, createdAt])
  @@index([customerId, offerId, status])
  @@index([orderId])
  @@map("store_offer_usages")
}

// =============================================================================
// Entrega
// =============================================================================

model DeliveryZone {
  id            String   @id @default(uuid())
  tenantId      String
  storeId       String
  name          String
  fee           Int      @default(0) // Taxa em centavos
  minOrderValue Int? // Pedido mínimo em centavos (opcional)
  estimatedTime String? // Ex: "30-40 min"
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store               Store                     @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  postalRanges        DeliveryZonePostalRange[]
  customerAddressUses CustomerAddressStoreUse[]

  @@unique([id, tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
  @@index([sortOrder])
  @@map("delivery_zones")
}

model DeliveryZonePostalRange {
  id              String   @id @default(uuid())
  tenantId        String
  storeId         String
  deliveryZoneId  String
  postalCodeStart String   @db.Char(8)
  postalCodeEnd   String   @db.Char(8)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deliveryZone DeliveryZone @relation(fields: [deliveryZoneId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@unique([deliveryZoneId, postalCodeStart, postalCodeEnd], map: "delivery_zone_postal_ranges_zone_start_end_key")
  @@index([tenantId, storeId, isActive])
  @@index([deliveryZoneId, isActive])
  @@index([storeId, postalCodeStart, postalCodeEnd])
  @@map("delivery_zone_postal_ranges")
}

// =============================================================================
// Clientes
// =============================================================================

model Customer {
  id                        String                     @id @default(uuid())
  tenantId                  String
  name                      String
  phone                     String
  phoneNormalized           String                     @db.VarChar(13)
  lastOrderAt               DateTime?
  recognitionEnabled        Boolean                    @default(false)
  consumerIdentityId        String?
  consumerIdentityLinkedAt  DateTime?
  consumerIdentityLinkProof ConsumerIdentityLinkProof?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  tenant                       Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consumerIdentity             ConsumerIdentity?                     @relation(fields: [consumerIdentityId], references: [id], onDelete: Restrict)
  addresses                    CustomerAddress[]
  orders                       Order[]
  recognitionSessions          CheckoutRecognitionSession[]
  recognitionAddressReferences CheckoutRecognitionAddressReference[]
  deviceRecognitions           CustomerDeviceRecognition[]
  verificationChallenges       ConsumerVerificationChallenge[]

  @@unique([tenantId, phone])
  @@unique([id, tenantId])
  @@unique([tenantId, phoneNormalized])
  @@unique([tenantId, consumerIdentityId])
  @@index([tenantId])
  @@index([phone])
  @@index([consumerIdentityId])
  @@map("customers")
}

model ConsumerIdentity {
  id              String    @id @default(uuid())
  phoneNormalized String?   @unique @db.VarChar(13)
  phoneVerifiedAt DateTime?
  emailNormalized String?   @unique @db.VarChar(254)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customers  Customer[]
  sessions   ConsumerSession[]
  challenges ConsumerVerificationChallenge[]

  @@index([phoneVerifiedAt])
  @@index([emailVerifiedAt])
  @@map("consumer_identities")
}

model ConsumerSession {
  id                 String    @id @default(uuid())
  consumerIdentityId String
  tokenHash          String    @unique @db.Char(64)
  expiresAt          DateTime
  lastUsedAt         DateTime  @default(now())
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  consumerIdentity ConsumerIdentity @relation(fields: [consumerIdentityId], references: [id], onDelete: Cascade)

  @@index([consumerIdentityId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("consumer_sessions")
}

model ConsumerVerificationChallenge {
  id                 String                      @id @default(uuid())
  challengeTokenHash String                      @unique @db.Char(64)
  tenantId           String
  storeId            String
  phoneNormalized    String?                     @db.VarChar(13)
  emailNormalized    String?                     @db.VarChar(254)
  otpHash            String?                     @db.Char(64)
  purpose            ConsumerVerificationPurpose
  status             ConsumerVerificationStatus  @default(PENDING)
  provider           String                      @db.VarChar(24)
  consumerIdentityId String?
  claimCustomerId    String?
  claimOrderId       String?
  attemptCount       Int                         @default(0)
  resendCount        Int                         @default(0)
  resendAfter        DateTime
  expiresAt          DateTime
  verifiedAt         DateTime?
  consumedAt         DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store             @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  consumerIdentity ConsumerIdentity? @relation(fields: [consumerIdentityId], references: [id], onDelete: SetNull)
  claimCustomer    Customer?         @relation(fields: [claimCustomerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  claimOrder       Order?            @relation(fields: [claimOrderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@index([tenantId, storeId, phoneNormalized, createdAt])
  @@index([tenantId, storeId, emailNormalized, createdAt])
  @@index([claimCustomerId, expiresAt])
  @@index([expiresAt, status])
  @@map("consumer_verification_challenges")
}

model CustomerAddress {
  id                 String               @id @default(uuid())
  tenantId           String
  customerId         String
  label              CustomerAddressLabel @default(OTHER)
  street             String
  number             String
  complement         String?
  neighborhood       String
  city               String
  state              String
  zipCode            String?
  reference          String?
  addressFingerprint String               @db.Char(64)
  isDefault          Boolean              @default(false)
  lastUsedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  customer              Customer                              @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  storeUses             CustomerAddressStoreUse[]
  recognitionReferences CheckoutRecognitionAddressReference[]

  @@unique([id, tenantId])
  @@unique([customerId, addressFingerprint])
  @@index([tenantId])
  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerAddressStoreUse {
  id                String   @id @default(uuid())
  tenantId          String
  storeId           String
  customerAddressId String
  deliveryZoneId    String
  lastUsedAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store           Store           @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customerAddress CustomerAddress @relation(fields: [customerAddressId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deliveryZone    DeliveryZone    @relation(fields: [deliveryZoneId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@unique([customerAddressId, storeId])
  @@index([tenantId, storeId, lastUsedAt])
  @@index([deliveryZoneId, tenantId, storeId])
  @@map("customer_address_store_uses")
}

model CheckoutRecognitionSession {
  id                  String                               @id @default(uuid())
  tokenHash           String                               @unique @db.Char(64)
  tenantId            String
  storeId             String
  customerId          String?
  deviceRecognitionId String?
  attemptCount        Int                                  @default(0)
  consecutiveFailures Int                                  @default(0)
  nextAttemptAt       DateTime?
  blockedUntil        DateTime?
  confirmedAt         DateTime?
  confirmationMode    CheckoutRecognitionConfirmationMode?
  expiresAt           DateTime
  invalidatedAt       DateTime?
  consumedAt          DateTime?
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt

  store             Store                                 @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customer          Customer?                             @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  deviceRecognition CustomerDeviceRecognition?            @relation(fields: [deviceRecognitionId], references: [id], onDelete: SetNull)
  addressReferences CheckoutRecognitionAddressReference[]

  @@index([tenantId, storeId, expiresAt])
  @@index([customerId, expiresAt])
  @@index([deviceRecognitionId, expiresAt])
  @@index([expiresAt])
  @@map("checkout_recognition_sessions")
}

model StorefrontDevice {
  id         String   @id @default(uuid())
  tokenHash  String   @unique @db.Char(64)
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recognitions CustomerDeviceRecognition[]

  @@index([expiresAt])
  @@map("storefront_devices")
}

model CustomerDeviceRecognition {
  id                 String    @id @default(uuid())
  storefrontDeviceId String
  tenantId           String
  storeId            String
  customerId         String
  lastUsedAt         DateTime  @default(now())
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  storefrontDevice    StorefrontDevice             @relation(fields: [storefrontDeviceId], references: [id], onDelete: Cascade)
  tenant              Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store               Store                        @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customer            Customer                     @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  recognitionSessions CheckoutRecognitionSession[]

  @@unique([storefrontDeviceId, storeId])
  @@unique([id, tenantId, storeId, customerId])
  @@index([tenantId, storeId, expiresAt])
  @@index([customerId, storeId, revokedAt, lastUsedAt])
  @@index([storefrontDeviceId, expiresAt])
  @@map("customer_device_recognitions")
}

model CheckoutRecognitionAddressReference {
  id                   String    @id @default(uuid())
  referenceHash        String    @unique @db.Char(64)
  recognitionSessionId String
  tenantId             String
  storeId              String
  customerId           String
  customerAddressId    String
  addressUpdatedAt     DateTime
  confirmedAt          DateTime?
  expiresAt            DateTime
  invalidatedAt        DateTime?
  consumedAt           DateTime?
  createdAt            DateTime  @default(now())

  recognitionSession CheckoutRecognitionSession @relation(fields: [recognitionSessionId], references: [id], onDelete: Cascade)
  store              Store                      @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customer           Customer                   @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customerAddress    CustomerAddress            @relation(fields: [customerAddressId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([recognitionSessionId, expiresAt])
  @@index([tenantId, storeId, expiresAt])
  @@index([customerAddressId, expiresAt])
  @@map("checkout_recognition_address_references")
}

model CustomerRecognitionThrottle {
  id              String                           @id @default(uuid())
  tenantId        String
  storeId         String?
  scope           CustomerRecognitionThrottleScope
  keyHash         String                           @db.Char(64)
  failureCount    Int                              @default(0)
  windowStartedAt DateTime                         @default(now())
  nextAttemptAt   DateTime?
  blockedUntil    DateTime?
  expiresAt       DateTime
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store? @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, scope, keyHash])
  @@index([expiresAt])
  @@index([tenantId, storeId, blockedUntil])
  @@map("customer_recognition_throttles")
}

// =============================================================================
// Pedidos
// =============================================================================

model StoreOrderCounter {
  storeId    String @id
  lastNumber Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_order_counters")
}

model StorePosTerminal {
  id             String   @id @default(uuid())
  tenantId       String
  storeId        String
  name           String   @db.VarChar(80)
  nameNormalized String   @db.VarChar(80)
  isActive       Boolean  @default(true)
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store      @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  drafts PosDraft[]
  orders Order[]

  @@unique([id, tenantId, storeId])
  @@unique([storeId, nameNormalized])
  @@index([tenantId, storeId, isActive, nameNormalized, id])
  @@map("store_pos_terminals")
}

model StorePosShortcut {
  id        String   @id @default(uuid())
  tenantId  String
  storeId   String
  productId String?
  offerId   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store   Store       @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product Product?    @relation(fields: [productId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  offer   StoreOffer? @relation(fields: [offerId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)

  @@unique([id, tenantId, storeId])
  @@unique([storeId, position])
  @@index([tenantId, storeId, position, id])
  @@index([productId, tenantId, storeId])
  @@index([offerId, tenantId, storeId])
  @@map("store_pos_shortcuts")
}

model PosDraft {
  id                String         @id @default(uuid())
  tenantId          String
  storeId           String
  createdById       String
  terminalId        String?
  convertedOrderId  String?        @unique
  modality          OrderModality
  status            PosDraftStatus @default(OPEN)
  version           Int            @default(0)
  payloadCiphertext String         @db.Text
  payloadIv         String         @db.VarChar(64)
  expiresAt         DateTime
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store          Store             @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  createdBy      User              @relation("PosDraftCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  terminal       StorePosTerminal? @relation(fields: [terminalId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)
  convertedOrder Order?            @relation("PosDraftConvertedOrder", fields: [convertedOrderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, status, expiresAt, updatedAt, id])
  @@index([createdById, status, updatedAt, id])
  @@index([terminalId, tenantId, storeId])
  @@map("pos_drafts")
}

model Order {
  id                       String       @id @default(uuid())
  tenantId                 String
  storeId                  String
  customerId               String?
  createdById              String?
  origin                   OrderOrigin?
  posTerminalId            String?
  posTerminalLabelSnapshot String?      @db.VarChar(80)
  orderNumber              Int          @default(0)
  idempotencyKey           String
  idempotencyFingerprint   String?
  quoteFingerprint         String?      @db.VarChar(64)
  publicToken              String       @unique @default(uuid())
  publicTokenExpiresAt     DateTime     @default(dbgenerated("(CURRENT_TIMESTAMP + '30 days'::interval)"))
  paymentReportToken       String?      @unique @default(dbgenerated("(gen_random_uuid())::text"))
  paymentReportExpiresAt   DateTime?    @default(dbgenerated("(CURRENT_TIMESTAMP + '7 days'::interval)"))

  // Dados do cliente (snapshot)
  customerName            String?
  customerPhone           String?
  customerPhoneNormalized String?

  // Modalidade e endereço
  modality                 OrderModality
  diningTableId            String?
  diningTableSessionId     String?
  diningTableLabelSnapshot String?       @db.VarChar(80)
  deliveryAddress          String?
  deliveryZoneName         String?
  deliveryPostalCode       String?       @db.VarChar(8)
  deliveryStreet           String?       @db.VarChar(160)
  deliveryNumber           String?       @db.VarChar(30)
  deliveryComplement       String?       @db.VarChar(120)
  deliveryNeighborhood     String?       @db.VarChar(120)
  deliveryCity             String?       @db.VarChar(120)
  deliveryState            String?       @db.VarChar(2)
  deliveryReference        String?       @db.VarChar(200)
  promisedFulfillmentMinAt DateTime?
  promisedFulfillmentMaxAt DateTime?
  operationalStartedAt     DateTime?

  // Valores (em centavos)
  subtotal    Int
  discount    Int @default(0)
  deliveryFee Int @default(0)
  total       Int

  // Pagamento
  paymentMethod PaymentMethodType
  changeFor     Int? // Troco para (em centavos)

  // Status
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  version         Int           @default(0)
  statusChangedAt DateTime      @default(now())

  acceptedAt   DateTime?
  preparingAt  DateTime?
  readyAt      DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?

  cancelledById                      String?
  cancellationReasonCode             OrderCancellationReasonCode?
  cancellationNote                   String?                      @db.VarChar(500)
  cancellationSource                 OrderChangeSource?
  customerCancellationNoticeRequired Boolean?

  // Observações
  notes String?

  // Cupom
  couponId   String?
  couponCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store              Store               @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy          User?               @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy        User?               @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  diningTable        StoreDiningTable?   @relation(fields: [diningTableId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)
  diningTableSession DiningTableSession? @relation(fields: [diningTableSessionId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)
  posTerminal        StorePosTerminal?   @relation(fields: [posTerminalId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Restrict)

  items                          OrderItem[]
  offerGroups                    OrderOfferGroup[]
  priceAdjustments               OrderPriceAdjustment[]
  statusHistory                  OrderStatusHistory[]
  internalNotes                  OrderInternalNote[]
  payment                        Payment?
  outboxEvents                   OrderOutboxEvent[]
  paymentHistory                 PaymentStatusHistory[]
  couponUsages                   CouponUsage[]
  couponReservation              CouponReservation?
  pushSubscriptions              OrderPushSubscription[]
  webPushDispatches              WebPushDispatch[]
  webPushDeliveries              WebPushDelivery[]
  storeWebPushDispatches         StoreWebPushDispatch[]
  storeWebPushDeliveries         StoreWebPushDelivery[]
  operationalSlaAlerts           OrderOperationalSlaAlert[]
  mercadoPagoPayment             MercadoPagoPayment?
  orderOperationalSlaDeliveries  OrderOperationalSlaDelivery[]
  convertedPosDrafts             PosDraft[]                      @relation("PosDraftConvertedOrder")
  posManualDiscount              PosManualDiscountLedger?
  consumerVerificationChallenges ConsumerVerificationChallenge[]

  @@unique([storeId, idempotencyKey])
  @@unique([storeId, orderNumber])
  @@unique([id, tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([customerId])
  @@index([tenantId, storeId, customerId, createdAt, id])
  @@index([createdById, createdAt])
  @@index([diningTableId])
  @@index([diningTableSessionId])
  @@index([tenantId, storeId, diningTableSessionId, createdAt, id])
  @@index([tenantId, storeId, diningTableId, createdAt, id])
  @@index([cancelledById])
  @@index([publicToken])
  @@index([publicTokenExpiresAt])
  @@index([tenantId, storeId, createdAt, id])
  @@index([storeId, status, createdAt, id])
  @@index([storeId, paymentStatus, createdAt, id])
  @@index([storeId, status, statusChangedAt, id])
  @@index([storeId, customerPhoneNormalized, createdAt, id])
  @@index([storeId, origin, createdAt, id])
  @@index([posTerminalId, tenantId, storeId])
  @@map("orders")
}

model OrderInternalNote {
  id           String    @id @default(uuid())
  tenantId     String
  storeId      String
  orderId      String
  authorUserId String
  body         String    @db.VarChar(1000)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  order  Order @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  author User  @relation("OrderInternalNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt, id])
  @@index([tenantId, storeId, createdAt, id])
  @@map("order_internal_notes")
}

model OrderItem {
  id                     String  @id @default(uuid())
  orderId                String
  offerGroupId           String?
  offerComponentPosition Int?
  position               Int     @default(0)

  // Snapshot do produto no momento do pedido
  productId    String
  productName  String
  unitPrice    Int // Em centavos
  quantity     Int
  notes        String?
  itemTotal    Int // Em centavos (unitPrice * quantity + opções)
  imageUrl     String? // Snapshot da URL legada no momento da compra
  imageAssetId String? // Snapshot do StoreAsset no momento da compra

  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offerGroup       OrderOfferGroup?       @relation(fields: [offerGroupId, orderId], references: [id, orderId], onDelete: Restrict)
  options          OrderItemOption[]
  priceAdjustments OrderPriceAdjustment[]

  @@unique([id, orderId])
  @@index([orderId, position, id])
  @@index([offerGroupId, offerComponentPosition, id])
  @@index([productId])
  @@index([imageAssetId])
  @@map("order_items")
}

model OrderOfferGroup {
  id                    String         @id @default(uuid())
  tenantId              String
  storeId               String
  orderId               String
  offerType             OrderOfferType
  sourceOfferIdSnapshot String
  sourceOfferVersion    Int
  nameSnapshot          String         @db.VarChar(120)
  quantity              Int
  position              Int            @default(0)
  regularBaseAmount     Int
  offerBaseAmount       Int
  discountAmount        Int
  createdAt             DateTime       @default(now())

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store                  @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order            Order                  @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  items            OrderItem[]
  priceAdjustments OrderPriceAdjustment[]

  @@unique([id, tenantId, storeId])
  @@unique([id, orderId])
  @@index([orderId, position, id])
  @@index([tenantId, storeId, offerType, createdAt])
  @@map("order_offer_groups")
}

model OrderPriceAdjustment {
  id                String                   @id @default(uuid())
  tenantId          String
  storeId           String
  orderId           String
  adjustmentType    OrderPriceAdjustmentType
  sourceIdSnapshot  String?
  sourceVersion     Int?
  labelSnapshot     String                   @db.VarChar(120)
  amount            Int
  orderItemId       String?
  orderOfferGroupId String?
  position          Int                      @default(0)
  createdAt         DateTime                 @default(now())

  tenant         Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store          Store                    @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order          Order                    @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  orderItem      OrderItem?               @relation(fields: [orderItemId, orderId], references: [id, orderId], onDelete: Restrict)
  offerGroup     OrderOfferGroup?         @relation(fields: [orderOfferGroupId, orderId], references: [id, orderId], onDelete: Restrict)
  manualDiscount PosManualDiscountLedger?

  @@index([orderId, position, id])
  @@index([orderItemId])
  @@index([orderOfferGroupId])
  @@index([tenantId, storeId, adjustmentType, createdAt])
  @@map("order_price_adjustments")
}

model PosManualDiscountLedger {
  id             String                      @id @default(uuid())
  tenantId       String
  storeId        String
  orderId        String                      @unique
  adjustmentId   String                      @unique
  appliedById    String
  authorizedById String
  mode           PosManualDiscountMode
  requestedValue Int
  eligibleBase   Int
  amount         Int
  reasonCode     PosManualDiscountReasonCode
  reasonNote     String?                     @db.VarChar(200)
  createdAt      DateTime                    @default(now())

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store                @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order        Order                @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  adjustment   OrderPriceAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  appliedBy    User                 @relation("PosManualDiscountAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)
  authorizedBy User                 @relation("PosManualDiscountAuthorizedBy", fields: [authorizedById], references: [id], onDelete: Restrict)

  @@unique([id, tenantId, storeId])
  @@unique([orderId, tenantId, storeId])
  @@index([tenantId, storeId, createdAt, id])
  @@index([appliedById, createdAt, id])
  @@index([authorizedById, createdAt, id])
  @@map("pos_manual_discount_ledgers")
}

model OrderItemOption {
  id          String @id @default(uuid())
  orderItemId String
  position    Int    @default(0)

  // Snapshot da opção no momento do pedido
  optionId      String
  optionName    String
  optionPrice   Int // Em centavos
  groupId       String?
  groupName     String?
  groupPosition Int     @default(0)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId, groupPosition, position, id])
  @@map("order_item_options")
}

model OrderStatusHistory {
  id                String                       @id @default(uuid())
  orderId           String
  fromStatus        OrderStatus?
  toStatus          OrderStatus
  note              String?
  changedBy         String? // legado: userId ou "system"
  changedById       String?
  actorNameSnapshot String?
  source            OrderChangeSource            @default(SYSTEM)
  reasonCode        OrderCancellationReasonCode?
  versionFrom       Int?
  versionTo         Int?
  isUndo            Boolean                      @default(false)
  revertsHistoryId  String?                      @unique
  createdAt         DateTime                     @default(now())

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation("OrderStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderId, createdAt, id])
  @@index([changedById, createdAt])
  @@index([createdAt])
  @@map("order_status_history")
}

