model OrderOutboxEvent {
  /// Partial SQL-managed retention index:
  /// order_outbox_events_processed_retention_idx ON processedAt WHERE status = 'PROCESSED'.
  /// Partial SQL-managed Web Push projection index:
  /// order_outbox_events_web_push_projection_idx ON occurredAt, id for eligible event types.
  id               String               @id @default(uuid())
  tenantId         String
  storeId          String
  orderId          String
  auditLogId       String?              @unique
  eventType        OrderOutboxEventType
  aggregateVersion Int
  schemaVersion    Int                  @default(1)
  payload          Json
  status           OrderOutboxStatus    @default(PENDING)
  attempts         Int                  @default(0)
  availableAt      DateTime             @default(now())
  queuedAt         DateTime?
  lockedAt         DateTime?
  lockToken        String?              @db.Uuid
  processedAt      DateTime?
  failedAt         DateTime?
  lastError        String?              @db.VarChar(1000)
  occurredAt       DateTime
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store                  Store                  @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order                  Order                  @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
  auditLog               AuditLog?              @relation(fields: [auditLogId], references: [id], onDelete: SetNull)
  webPushDispatch        WebPushDispatch?
  webPushDeliveries      WebPushDelivery[]
  storeWebPushDispatch   StoreWebPushDispatch?
  storeWebPushDeliveries StoreWebPushDelivery[]

  @@unique([orderId, eventType, aggregateVersion])
  @@unique([id, tenantId, storeId])
  @@index([status, availableAt, createdAt])
  @@index([storeId, createdAt, id])
  @@index([orderId, createdAt, id])
  @@index([queuedAt, processedAt])
  @@map("order_outbox_events")
}

