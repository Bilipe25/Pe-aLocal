// =============================================================================
// Cupons
// =============================================================================

model Coupon {
  id            String     @id @default(uuid())
  tenantId      String
  storeId       String?
  code          String
  type          CouponType
  value         Int // Percentual (ex: 10 = 10%) ou centavos
  minOrderValue Int? // Pedido mínimo em centavos
  maxDiscount   Int? // Desconto máximo em centavos
  maxUsages     Int? // Limite total de usos
  usageCount    Int        @default(0)
  isActive      Boolean    @default(true)
  startsAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store?              @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  usages       CouponUsage[]
  reservations CouponReservation[]

  @@unique([tenantId, storeId, code])
  @@index([tenantId])
  @@index([tenantId, storeId, isActive])
  @@index([code])
  @@map("coupons")
}

model CouponReservation {
  id         String                  @id @default(uuid())
  couponId   String
  orderId    String                  @unique
  discount   Int
  status     CouponReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  consumedAt DateTime?
  releasedAt DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, status, expiresAt])
  @@index([status, expiresAt])
  @@map("coupon_reservations")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  orderId   String
  discount  Int // Desconto aplicado em centavos
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId])
  @@index([orderId])
  @@map("coupon_usages")
}

// =============================================================================
// Auditoria
// =============================================================================

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String?
  storeId   String?
  userId    String?
  action    AuditAction
  entity    String // Ex: "Product", "Order", "Store"
  entityId  String?
  metadata  Json? // Dados seguros (sem senhas, tokens, etc.)
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  store       Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  outboxEvent OrderOutboxEvent?

  @@index([tenantId])
  @@index([tenantId, createdAt, id])
  @@index([storeId])
  @@index([storeId, createdAt, id])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entity, entityId, createdAt, id])
  @@index([createdAt])
  @@map("audit_logs")
}
