  @@unique([storeId, provider])
  @@unique([id, tenantId, storeId])
  @@index([provider, providerUserId])
  @@index([tenantId, storeId, status])
  @@index([refreshLeaseExpiresAt])
  @@map("store_payment_provider_connections")
}

model PaymentProviderOAuthAttempt {
  id                     String          @id @default(uuid())
  tenantId               String
  storeId                String
  provider               PaymentProvider
  initiatedById          String
  stateHash              String          @unique @db.VarChar(64)
  codeVerifierCiphertext String?         @db.Text
  codeVerifierIv         String?         @db.VarChar(64)
  credentialVersion      Int             @default(1)
  returnPath             String          @db.VarChar(500)
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime        @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store       Store  @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  initiatedBy User   @relation("PaymentProviderOAuthAttemptInitiatedBy", fields: [initiatedById], references: [id], onDelete: Cascade)

  @@unique([id, tenantId, storeId])
  @@index([tenantId, storeId, provider, createdAt])
  @@index([expiresAt, consumedAt])
  @@index([initiatedById])
  @@map("payment_provider_oauth_attempts")
}

model MercadoPagoPayment {
  id                   String                    @id @default(uuid())
  tenantId             String
  storeId              String
  orderId              String                    @unique
  paymentId            String                    @unique
  connectionId         String
  creationStatus       MercadoPagoCreationStatus @default(PENDING)
  externalReference    String                    @unique @db.VarChar(150)
  idempotencyKey       String                    @unique @db.VarChar(150)
  providerOrderId      String?                   @unique @db.VarChar(100)
  providerPaymentId    String?                   @unique @db.VarChar(100)
  providerStatus       String?                   @db.VarChar(64)
  providerStatusDetail String?                   @db.VarChar(64)
  qrCode               String?                   @db.Text
  ticketUrl            String?                   @db.Text
  expiresAt            DateTime?
  payerEmailCiphertext String?                   @db.Text
  payerEmailIv         String?                   @db.VarChar(64)
  credentialVersion    Int                       @default(1)
  lastErrorCode        String?                   @db.VarChar(64)
  lastSyncedAt         DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  tenant     Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store      Store                          @relation(fields: [storeId, tenantId], references: [id, tenantId], onDelete: Cascade)
  order      Order                          @relation(fields: [orderId, tenantId, storeId], references: [id, tenantId, storeId], onDelete: Cascade)
