{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pedidolocal-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
    "remote": true,
  },
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
  "vars": {
    "APP_URL": "https://pedidolocal-staging.gabriellion97.workers.dev",
    "APP_ENV": "staging",
    "ORDER_EVENT_PUBLISH_MODE": "outbox",
    "WEB_PUSH_ENABLED": "true",
    "MERCHANT_WEB_PUSH_ENABLED": "false",
    "MERCADO_PAGO_ENABLED": "false",
    "CONSUMER_VERIFICATION_PROVIDER": "bird",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pedidolocal-staging",
    },
    {
      "binding": "ORDER_EVENTS_WORKER",
      "service": "pedidolocal-order-events-staging",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "pedidolocal-staging-opennext-cache",
    },
    {
      "binding": "STORE_ASSETS_R2",
      "bucket_name": "pedidolocal-staging-store-assets",
      "remote": true,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-opennext-cache",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "db9213cd1b214074928647719ddff805",
    },
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "8efb30a2a2eb4a9b87fa25e0509c4709",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "ORDER_OUTBOX_QUEUE",
        "queue": "pedidolocal-order-events-staging",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "ORDER_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "PAYMENT_REPORT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "CHECKOUT_QUOTE_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "ORDER_IP_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "env": {
    "staging": {
      "name": "pedidolocal-staging",
      "vars": {
        "APP_URL": "https://pedidolocal-staging.gabriellion97.workers.dev",
        "APP_ENV": "staging",
        "ORDER_EVENT_PUBLISH_MODE": "outbox",
        "WEB_PUSH_ENABLED": "true",
        "MERCHANT_WEB_PUSH_ENABLED": "true",
        "MERCADO_PAGO_ENABLED": "true",
        "MERCADO_PAGO_CLIENT_ID": "32620436153512",
        "MERCADO_PAGO_TEST_APPLICATION_ID": "1828304174612090",
        "MERCADO_PAGO_REDIRECT_URI": "https://pedidolocal-staging.gabriellion97.workers.dev/api/integrations/mercado-pago/oauth/callback",
        "CONSUMER_VERIFICATION_PROVIDER": "bird",
      },
      "images": {
        "binding": "IMAGES",
        "remote": true,
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "pedidolocal-staging",
        },
        {
          "binding": "ORDER_EVENTS_WORKER",
          "service": "pedidolocal-order-events-staging",
        },
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "pedidolocal-staging-opennext-cache",
        },
        {
          "binding": "STORE_ASSETS_R2",
          "bucket_name": "pedidolocal-staging-store-assets",
          "remote": true,
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NEXT_CACHE_DO_QUEUE",
            "class_name": "DOQueueHandler",
          },
          {
            "name": "NEXT_TAG_CACHE_DO_SHARDED",
            "class_name": "DOShardedTagCache",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1-opennext-cache",
          "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
        },
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "db9213cd1b214074928647719ddff805",
        },
        {
          "binding": "HYPERDRIVE_FRESH",
          "id": "8efb30a2a2eb4a9b87fa25e0509c4709",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "ORDER_OUTBOX_QUEUE",
            "queue": "pedidolocal-order-events-staging",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "ORDER_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "PAYMENT_REPORT_RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "CHECKOUT_QUOTE_RATE_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "ORDER_IP_RATE_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "pedidolocal-production",
      "vars": {
        "APP_URL": "https://pedidolocal-production.gabriellion97.workers.dev",
        "APP_ENV": "production",
        "ORDER_EVENT_PUBLISH_MODE": "direct",
        "WEB_PUSH_ENABLED": "false",
        "MERCHANT_WEB_PUSH_ENABLED": "false",
        "MERCADO_PAGO_ENABLED": "false",
        "CONSUMER_VERIFICATION_PROVIDER": "disabled",
      },
      "images": {
        "binding": "IMAGES",
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "pedidolocal-production",
        },
        {
          "binding": "ORDER_EVENTS_WORKER",
          "service": "pedidolocal-order-events-production",
        },
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "pedidolocal-production-opennext-cache",
        },
        {
          "binding": "STORE_ASSETS_R2",
          "bucket_name": "pedidolocal-production-store-assets",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NEXT_CACHE_DO_QUEUE",
            "class_name": "DOQueueHandler",
          },
          {
            "name": "NEXT_TAG_CACHE_DO_SHARDED",
            "class_name": "DOShardedTagCache",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1-opennext-cache",
          "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
        },
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "4e8ea7785f6443a682350235f432d380",
        },
        {
          "binding": "HYPERDRIVE_FRESH",
          "id": "5073a982b5594aa88a80a87f7cbf9520",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "ORDER_OUTBOX_QUEUE",
            "queue": "pedidolocal-order-events-production",
          },
        ],
      },
      "ratelimits": [
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "ORDER_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "PAYMENT_REPORT_RATE_LIMITER",
          "namespace_id": "2003",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "CHECKOUT_QUOTE_RATE_LIMITER",
          "namespace_id": "2004",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "ORDER_IP_RATE_LIMITER",
          "namespace_id": "2005",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
    },
  },
}
