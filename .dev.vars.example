# Copie para .dev.vars. Nunca versione .dev.vars.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"
SUPABASE_SECRET_KEY="sb_secret_REPLACE_ME"
APP_URL="http://localhost:8787"
# Obrigatório para OAuth Mercado Pago: development usa credenciais sandbox.
APP_ENV="development"
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
PUSHER_LEGACY_PUBLIC_CHANNELS="false"
ORDER_EVENT_PUBLISH_MODE="direct"
# O modo OAuth é derivado exclusivamente de APP_ENV; não exponha essa decisão ao browser.
MERCADO_PAGO_ENABLED="false"
MERCADO_PAGO_CLIENT_ID=""
MERCADO_PAGO_CLIENT_SECRET=""
MERCADO_PAGO_REDIRECT_URI="http://localhost:8787/api/integrations/mercado-pago/oauth/callback"
MERCADO_PAGO_WEBHOOK_SECRET=""
MERCADO_PAGO_CREDENTIAL_ENCRYPTION_KEY=""
WEB_PUSH_ENABLED="false"
MERCHANT_WEB_PUSH_ENABLED="false"
WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""
WEB_PUSH_VAPID_SUBJECT="mailto:operacoes@example.com"

# Hyperdrive local lê esta variável sem colocar a URL no wrangler.jsonc.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
